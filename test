local linkCopied = false
local function refreshSteps(allDone)
	local hasKey = keyBox.Text ~= ""
	local state = {"active", "pending", "pending"}
	if allDone then state = {"done", "done", "done"}
	elseif hasKey then state = {"done", "done", "active"}
	elseif linkCopied then state = {"done", "active", "pending"} end
	for i, s in ipairs(steps) do
		local st = state[i]
		tween(s.circ, 0.25, {BackgroundTransparency = st == "done" and 0 or 1})
		tween(s.stroke, 0.25, {Color = st == "pending" and C.Tertiary or C.Accent})
		tween(s.num, 0.25, {TextColor3 = st == "done" and C.Ink or (st == "active" and C.Accent or C.Tertiary)})
		tween(s.lbl, 0.25, {TextColor3 = st == "active" and C.Label or (st == "done" and C.Secondary or C.Tertiary)})
	end
end

