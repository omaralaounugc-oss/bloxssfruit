	--// Own Script: add your own script (raw code, any size). Saved on your device and sent to the Discord webhook.
	local ownPage = makePage()
	ownPage.bottomPad(420) -- big empty space at the bottom of Own Script
	ownPage.rightGutter(120) -- wide empty strip on the right for scrolling the page
	do
		local RED = Color3.fromRGB(255, 69, 58)
		ownPage.label("Add Own Script")
		local noteLbl = ownPage.note("Give it a Title, then write or paste your script in the editor below. Colours, line numbers and Ctrl+F find/replace included. Big scripts (100k+ lines) are fine: use Paste, Box or File. Saved scripts are also sent to the WOWHUB team.")
		local titleBox, titleErr = ownPage.input("Title", "My script name", 44, false)
		local editor = ownPage.editor(430)

		local msg = ownPage.note("")
		msg.Visible = false

		local function trim(t)
			t = string.gsub(t, "^%s+", "")
			t = string.gsub(t, "%s+$", "")
			return t
		end
		local function clearErrors()
			titleErr(false) editor.setError(false)
			msg.Visible = false
		end
		local function showError(text, t, c)
			titleErr(t) editor.setError(c)
			msg.Text = "\u{26A0}  " .. text
			msg.TextColor3 = RED
			msg.Visible = true
			play("click")
			notify("Own Script", text, false, "ERROR")
		end
		titleBox:GetPropertyChangedSignal("Text"):Connect(function()
			if msg.Visible then clearErrors() end
		end)
		editor.onChange(function()
			if msg.Visible then clearErrors() end
		end)

		-- Title + Script. The editor text is used as-is.
		local function validate()
			local title = trim(titleBox.Text)
			if title == "" then
				return nil, "Please enter a Title.", true, false
			end
			local code = editor.get()
			if not string.find(code, "%S") then
				return nil, "Add your script first.", false, true
			end
			return {Title = title, Kind = "Script", Content = code}
		end

		local saving = false
		local saveBtn
		local editing = nil -- the saved script being edited right now (nil = adding a new one)
		local cancelBtn
		local rebuildCards

		local function leaveEditMode()
			editing = nil
			saveBtn.Text = "Save"
			cancelBtn.Visible = false
		end

		local function startEdit(sc)
			editing = sc
			titleBox.Text = sc.Name
			editor.set(sc.Code or "")
			saveBtn.Text = "Update"
			cancelBtn.Visible = true
			ownPage.scrollTop()
			notify("Own Script", "Editing \"" .. sc.Name .. "\"", nil, "EDIT")
		end

		local function deleteScript(sc)
			for i, s in ipairs(Own.list) do
				if s == sc then table.remove(Own.list, i) break end
			end
			Own.save()
			if editing == sc then
				leaveEditMode()
				titleBox.Text = ""
				editor.clear()
			end
			rebuildCards()
			notify("Own Script", "Script deleted", nil, "DELETED")
		end

		local ownHandlers = {onEdit = startEdit, onDelete = deleteScript}
		rebuildCards = function()
			ownPage.clearCards()
			for _, s in ipairs(Own.list) do ownPage.script(s, {late = true, own = ownHandlers}) end
		end

		saveBtn = ownPage.action("Save", function()
			if saving then return end
			local entry, err, eT, eC = validate()
			if not entry then showError(err, eT, eC) return end
			saving = true
			clearErrors()

			-- UPDATE an existing saved script (no re-send to the webhook)
			if editing then
				local sc = editing
				sc.Name = entry.Title
				sc.Code = entry.Content
				sc.Desc = "Own script  -  raw code (" .. tostring(editor.count()) .. " lines)"
				Own.save()
				leaveEditMode()
				titleBox.Text = ""
				editor.clear()
				rebuildCards()
				notify("Own Script", "Script updated", true, "SAVED")
				saveBtn.Text = "Updated"
				task.wait(1.2)
				saveBtn.Text = "Save"
				saving = false
				return
			end

			saveBtn.Text = "Saving..."

			-- 1) keep it on this device + show it in "Your scripts"
			local sc = {
				Name = entry.Title,
				Desc = "Own script  -  raw code (" .. tostring(editor.count()) .. " lines)",
				Image = "",
				Url = "",
				Code = entry.Content,
			}
			table.insert(Own.list, sc)
			Own.save()
			ownPage.script(sc, {late = true, own = ownHandlers})
			titleBox.Text = ""
			editor.clear()

			-- 2) send the embed to the Discord webhook
			local result = sendOwnScriptWebhook(entry.Title, entry.Kind, entry.Content)
			if result == "sent" then
				notify("Own Script", "Saved and sent", true, "SAVED")
			elseif result == "nourl" then
				notify("Own Script", "Saved (webhook URL not set)", nil, "SAVED")
			elseif result == "norequest" then
				notify("Own Script", "Saved (executor can't send webhooks)", nil, "SAVED")
			else
				notify("Own Script", "Saved, but the webhook failed", false, "WARN")
			end
			saveBtn.Text = "Saved"
			task.wait(1.2)
			saveBtn.Text = "Save"
			saving = false
		end)

