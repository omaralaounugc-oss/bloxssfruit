--// ROBLOX OUTPUTS STORE: captures every print / warn / error Roblox writes (starts the moment the hub loads)
local Outputs = {list = {}, max = 2000, nextId = 0, subs = {}, counts = {print = 0, info = 0, warn = 0, error = 0}}
do
	local KIND = {
		[Enum.MessageType.MessageOutput]  = "print",
		[Enum.MessageType.MessageInfo]    = "info",
		[Enum.MessageType.MessageWarning] = "warn",
		[Enum.MessageType.MessageError]   = "error",
	}
	function Outputs.add(kind, text, stamp)
		Outputs.nextId += 1
		local e = {id = Outputs.nextId, kind = kind, text = tostring(text), time = stamp or os.date("%H:%M:%S")}
		local list = Outputs.list
		list[#list + 1] = e
		if #list > Outputs.max + 200 then -- drop the oldest 200 in one go
			local n = #list
			table.move(list, 201, n, 1)
			for i = n - 199, n do list[i] = nil end
		end
		Outputs.counts[kind] += 1
		for _, f in ipairs(Outputs.subs) do pcall(f, e) end
	end
	-- older output that was already in the Roblox console before the hub started
	pcall(function()
		local hist = LogService:GetLogHistory()
		for i = math.max(1, #hist - 499), #hist do
			local m = hist[i]
			Outputs.add(KIND[m.messageType] or "print", m.message, os.date("%H:%M:%S", m.timestamp))
		end
	end)
	Outputs.conn = LogService.MessageOut:Connect(function(message, mtype)
		Outputs.add(KIND[mtype] or "print", message)
	end)
end

