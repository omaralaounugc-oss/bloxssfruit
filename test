		-- script card: rounded inset thumbnail, title + description, Execute button
		function api.script(sc, opts)
			order += 1
			local THUMB_W = 600
			local card = new("Frame", {
				Size = UDim2.new(1, 0, 0, 68), LayoutOrder = order, BackgroundColor3 = C.Group,
				BackgroundTransparency = 0.12, BorderSizePixel = 0, ZIndex = 5,
			}, { round(16) })
			card.Parent = page

