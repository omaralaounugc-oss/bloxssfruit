local function buzz(strength, dur)
	if CONFIG.Haptics == false then return end
	pcall(function()
		local input = Enum.UserInputType.Gamepad1
		if HapticService:IsVibrationSupported(input) and HapticService:IsMotorSupported(input, Enum.VibrationMotor.Small) then
			HapticService:SetMotor(input, Enum.VibrationMotor.Small, strength)
			task.delay(dur, function() HapticService:SetMotor(input, Enum.VibrationMotor.Small, 0) end)
		end
	end)
end

