	-- group fade without CanvasGroup (fades every descendant's transparency)
	local function gfade(root, to, t)
		t = t / Tut.speed
		local from = (to == 0) and 1 or 0
		local list = root:GetDescendants()
		table.insert(list, root)
		local recs = {}
		for _, d in ipairs(list) do
			local r
			if d:IsA("GuiObject") then r = r or {}; r.BackgroundTransparency = d.BackgroundTransparency end
			if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then r = r or {}; r.TextTransparency = d.TextTransparency end
			if d:IsA("ImageLabel") or d:IsA("ImageButton") then r = r or {}; r.ImageTransparency = d.ImageTransparency end
			if d:IsA("UIStroke") then r = r or {}; r.Transparency = d.Transparency end
			if r then recs[d] = r end
		end
		local function apply(a)
			for d, r in pairs(recs) do
				if d.Parent then
					for prop, b in pairs(r) do d[prop] = b + (1 - b) * a end
				end
			end
		end
		apply(from)
		if to == 0 and root:IsA("GuiObject") then root.Visible = true end
		task.spawn(function()
			local t0 = os.clock()
			while true do
				local x = math.clamp((os.clock() - t0) / t, 0, 1)
				apply(from + (to - from) * TweenService:GetValue(x, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
				if x >= 1 or not alive then break end
				task.wait()
			end
			if to == 1 and root.Parent and root:IsA("GuiObject") then root.Visible = false end
		end)
	end

