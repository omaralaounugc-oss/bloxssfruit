					local a, b = math.min(fb.SelectionStart, fb.CursorPosition), math.max(fb.SelectionStart, fb.CursorPosition)
					sel = string.sub(fb.Text, a, b - 1)
					if sel == "" or string.find(sel, "[\r\n]") then sel = nil end
				end
				local want = prefill or sel or old
				task.defer(function()
					task.wait()
					findBox.Text = want
					findBox:CaptureFocus()
					buildMatches()
				end)
			end

			local function runQuery()
				local t = findBox.Text
