local function normalizeKey(s)
	s = tostring(s or "")
	for _, junk in ipairs({"\226\128\139", "\226\128\140", "\226\128\141", "\239\187\191", "\194\160"}) do
		s = s:gsub(junk, "")
	end
	s = s:gsub("[%c%s\"']", "")
	return s
end
local function fmtRemaining(secs)
	if not secs then return "Lifetime" end
	if secs <= 0 then return "Expired" end
	local d, h, m = math.floor(secs / 86400), math.floor(secs % 86400 / 3600), math.floor(secs % 3600 / 60)
	if d > 0 then return d .. "d " .. h .. "h" end
	if h > 0 then return h .. "h " .. m .. "m" end
	return math.max(m, 1) .. "m"
end

