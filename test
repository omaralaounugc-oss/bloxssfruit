	if keyBox.Text ~= "" or not getclipboard or CONFIG.ClipboardPeek == false then return end
	local c = normalizeKey(getclipboard())
	if #c >= 8 and #c <= 80 and not c:find("/", 1, true) and not c:find(":", 1, true) and c:find("[%d%-_]")
		and (not CONFIG.KeyPattern or c:match(CONFIG.KeyPattern)) then
		clipKey = c
		setStatus("Key found in your clipboard - tap Paste & Unlock", C.Accent, C.Green, "Ready")
