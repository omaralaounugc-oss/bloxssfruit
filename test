		-- iOS-style slider: drag the knob, calls callback(value) with whole numbers
		function api.slider(text, min, max, default, callback, suffix)
			local row = baseRow(text)
			row.Size = UDim2.new(1, 0, 0, 74)
			suffix = suffix or ""
			local lbl = row:FindFirstChildOfClass("TextLabel")
			lbl.Size = UDim2.new(0.6, 0, 0, 46)
			local valLbl = new("TextLabel", {
				Size = UDim2.new(0.3, 0, 0, 46), Position = UDim2.new(1, -16, 0, 0),
				AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, Text = "",
				Font = F_REG, TextSize = 15, TextColor3 = C.Secondary,
				TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 8,
			})
			valLbl.Parent = row
			local hit = new("TextButton", {
				Size = UDim2.new(1, -32, 0, 30), Position = UDim2.new(0, 16, 0, 40),
				BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 8,
			})
			hit.Parent = row
			local bar = new("Frame", {
				Size = UDim2.new(1, 0, 0, 6), Position = UDim2.fromScale(0, 0.5), AnchorPoint = Vector2.new(0, 0.5),
				BackgroundColor3 = C.SwitchOff, BorderSizePixel = 0, ZIndex = 9,
			}, { pill() })
			bar.Parent = hit
			local fill = new("Frame", {
				Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Blue, BorderSizePixel = 0, ZIndex = 10,
			}, { pill() })
			fill.Parent = bar
			local knob = new("Frame", {
				Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
				BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 11,
			}, { pill(), new("UIStroke", {Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.86}) })
			knob.Parent = bar

			local lastV, lastSnd, atEdge = nil, 0, false
			local function setAlpha(a, fire)
				a = math.clamp(a, 0, 1)
				local v = math.floor(min + (max - min) * a + 0.5)
				fill.Size = UDim2.fromScale(a, 1)
				knob.Position = UDim2.fromScale(a, 0.5)
				valLbl.Text = v .. suffix
				if fire and v ~= lastV then
					-- sound: a soft tick that rises in pitch as the value goes up, a thud at either end
					local now = os.clock()
					local edge = (a <= 0 or a >= 1)
					if edge and not atEdge then
						play("limit", a >= 1 and 0.9 or 0.62); buzz(0.35, 0.05)
					elseif not edge and now - lastSnd > 0.045 then
						play("tick", 0.85 + a * 1.2)
						lastSnd = now
					end
					atEdge = edge
					lastV = v
					if callback then task.spawn(callback, v) end
				end
				lastV = v
			end
			setAlpha((math.clamp(default, min, max) - min) / (max - min), false)

			local dragging = false
			local function fromInput(input)
				local w = bar.AbsoluteSize.X
				if w > 0 then setAlpha((input.Position.X - bar.AbsolutePosition.X) / w, true) end
			end
			hit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					page.ScrollingEnabled = false -- keep the page from scrolling while sliding
					play("grab"); buzz(0.25, 0.04)
					tween(knob, 0.15, {Size = UDim2.fromOffset(28, 28)}, Enum.EasingStyle.Back)
					fromInput(input)
					input.Changed:Connect(function()
						if input.UserInputState == Enum.UserInputState.End then
							dragging = false
							page.ScrollingEnabled = true
							play("drop"); buzz(0.3, 0.04)
							tween(knob, 0.3, {Size = UDim2.fromOffset(22, 22)}, Enum.EasingStyle.Back)
						end
					end)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch) then
					fromInput(input)
				end
			end)
			return {set = function(v) setAlpha((math.clamp(v, min, max) - min) / (max - min), false) end}
		end


