--// Resizing: drag the grip in the bottom-right corner to change the hub size
do
	local grip = new("TextButton", {
		Name = "ResizeGrip", Size = UDim2.fromOffset(34, 34), Position = UDim2.new(1, -4, 1, -4),
		AnchorPoint = Vector2.new(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1,
		Text = "", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 60,
	}, { round(12) })
	-- three diagonal strokes pointing at the corner
	local lines = {}
	for _, spec in ipairs({{24, 6}, {19, 12}, {14, 18}}) do
		local ln = new("Frame", {
			Size = UDim2.fromOffset(2, spec[2]), Position = UDim2.fromOffset(spec[1], spec[1]),
			AnchorPoint = Vector2.new(0.5, 0.5), Rotation = 45, BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 61,
		}, { pill() })
		ln.Parent = grip
		table.insert(lines, ln)
	end
	grip.Parent = main

	local sizeC = holder:FindFirstChildOfClass("UISizeConstraint")
	local resizing, startInput, startSize, startPos
	local lastTickAt, lastTickSize, atLimit = 0, Vector2.new(), false
	grip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			startInput, startSize, startPos = input.Position, holder.AbsoluteSize / (uiScale.Scale * BASE), holder.Position
			if sizeC then sizeC.MaxSize = Vector2.new(8192, 8192) end -- lift the default size cap
			for _, ln in ipairs(lines) do tween(ln, 0.15, {BackgroundTransparency = 0.05}) end
			lastTickAt, lastTickSize, atLimit = 0, startSize, false
			play("grab"); buzz(0.25, 0.04)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					if resizing then play("drop"); buzz(0.2, 0.05) end
					resizing = false
					for _, ln in ipairs(lines) do tween(ln, 0.3, {BackgroundTransparency = 0.55}) end
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local sc = uiScale.Scale
			local minS = sizeC and sizeC.MinSize or Vector2.new(480, 270)
			local screen = gui.AbsoluteSize / BASE
			local maxW = math.max(minS.X, (screen.X - 16) / sc)
			local maxH = math.max(minS.Y, (screen.Y - 44) / sc)
			local d = (input.Position - startInput) / (sc * BASE)
			local w = math.clamp(startSize.X + d.X, minS.X, maxW)
			local h = math.clamp(startSize.Y + d.Y, minS.Y, maxH)
			holder.Size = UDim2.fromOffset(w, h)
			-- iOS-style detent: a soft tick every ~26px of growth/shrink, pitch follows direction
			local moved = (Vector2.new(w, h) - lastTickSize).Magnitude
			if moved >= 26 and os.clock() - lastTickAt > 0.05 then
				local grew = (w + h) > (lastTickSize.X + lastTickSize.Y)
				play("tick", grew and 1.5 or 1.3)
				lastTickAt, lastTickSize = os.clock(), Vector2.new(w, h)
			end
			-- a firmer thud once when the size limit is reached
			local clamped = (w <= minS.X or h <= minS.Y or w >= maxW or h >= maxH)
			if clamped and not atLimit then play("limit"); buzz(0.35, 0.05) end
			atLimit = clamped
			-- keep the top-left corner fixed (holder is centre-anchored)
			holder.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + (w - startSize.X) * sc / 2,
				startPos.Y.Scale, startPos.Y.Offset + (h - startSize.Y) * sc / 2)
		end
	end)
end

