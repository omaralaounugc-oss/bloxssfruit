		-- CODE EDITOR: syntax colours, line numbers, Ctrl+F find/replace, go-to-line, status bar.
		-- Virtualized (only ~25 rows exist), so 100k+ lines stay fast.
		-- Returns an object: get(), set(text), clear(), count(), setError(on), onChange(fn)
		function api.editor(height)
			order = order + 1
			local ROW_H, GUT_W, CANVAS_W, LONG, TEXT_SIZE = 20, 52, 3000, 1500, 14
			local CHAR_W = TEXT_SIZE * 0.6
			local LIVE_COLOR = true -- true: coloured text while typing (transparent TextBox over a RichText label)
			local MAXM = 5000       -- max find matches kept
			local UIS = game:GetService("UserInputService")
			local BG_CODE, BG_GUT, BG_BAR = Color3.fromRGB(24, 24, 27), Color3.fromRGB(30, 30, 34), Color3.fromRGB(34, 34, 38)
			local TXT = Color3.fromRGB(212, 212, 212)
			local lines = {""}
			local startState = {0}
			local totalBytes = 0
			local rows = {}
			local refreshing = false
			local lastFirst = -1
			local changeFn = nil
			local hovering = false

			-- ===== Lua syntax highlighter (per line, with block comment / long string state across lines) =====
			local COL = {"#C586C0", "#CE9178", "#6A9955", "#B5CEA8", "#4FC1FF", "#DCDCAA"}
			-- colour ids: 1 keyword, 2 string, 3 comment, 4 number, 5 builtin/global, 6 function name/call
			local KEYWORDS, BUILTINS = {}, {}
			for w in string.gmatch("and break do else elseif end false for function if in local nil not or repeat return then true until while continue", "%S+") do KEYWORDS[w] = true end
			for w in string.gmatch("print warn error assert pcall xpcall pairs ipairs next type typeof tostring tonumber select require loadstring unpack rawget rawset rawequal rawlen setmetatable getmetatable game workspace script shared _G _VERSION task wait spawn delay tick time os math string table utf8 coroutine bit32 buffer debug Instance Vector3 Vector2 CFrame Color3 BrickColor UDim UDim2 Enum Ray Region3 TweenInfo NumberRange NumberSequence ColorSequence Rect Random self getgenv getrenv getfenv setfenv getrawmetatable setreadonly hookfunction hookmetamethod newcclosure checkcaller request http_request writefile readfile isfile setclipboard getclipboard fireclickdetector firetouchinterest fireproximityprompt Drawing getconnections cloneref", "%S+") do BUILTINS[w] = true end
			local segS, segE, segC = {}, {}, {}

			local function esc(s)
				return (string.gsub(string.gsub(string.gsub(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
			end

			-- state: 0 = normal, 100+L = inside --[=*[ block comment, 200+L = inside [=*[ long string (L = number of "=")
			local function tokenize(line, state, rich)
				local n = #line
				local cnt = 0
				local function add(s, e, c)
					if not rich or e < s then return end
					if cnt > 0 and segC[cnt] == c and segE[cnt] == s - 1 then segE[cnt] = e return end
					cnt = cnt + 1
					segS[cnt], segE[cnt], segC[cnt] = s, e, c
				end
				local i = 1
				if state ~= 0 then
					local kind, level = math.floor(state / 100), state % 100
					local closer = "]" .. string.rep("=", level) .. "]"
					local _, e = string.find(line, closer, 1, true)
					local colr = (kind == 1) and 3 or 2
					if not e then add(1, n, colr) return cnt, state end
					add(1, e, colr)
					i = e + 1
				end
				local ps, pw = "", "" -- previous significant char / previous word
				while i <= n do
					local c = string.sub(line, i, i)
					if c == " " or c == "\t" then
						local _, e = string.find(line, "^[ \t]+", i)
						add(i, e, 0)
						i = e + 1
					elseif c == "-" and string.sub(line, i + 1, i + 1) == "-" then
						local eq = string.match(line, "^%[(=*)%[", i + 2)
						if eq then
							local closer = "]" .. eq .. "]"
							local _, e = string.find(line, closer, i + #eq + 4, true)
							if e then add(i, e, 3) i = e + 1
							else add(i, n, 3) return cnt, 100 + #eq end
						else
							add(i, n, 3)
							i = n + 1
						end
						ps, pw = "", ""
					elseif c == '"' or c == "'" then
						local j, e = i + 1, n
						while true do
							local k = string.find(line, "[\\" .. c .. "]", j)
							if not k then e = n break end
							if string.sub(line, k, k) == "\\" then j = k + 2 else e = k break end
						end
						add(i, e, 2)
						i = e + 1
						ps, pw = c, ""
					elseif c == "[" then
						local eq = string.match(line, "^%[(=*)%[", i)
						if eq then
							local closer = "]" .. eq .. "]"
							local _, e = string.find(line, closer, i + #eq + 2, true)
							if e then add(i, e, 2) i = e + 1
							else add(i, n, 2) return cnt, 200 + #eq end
						else
							add(i, i, 0)
							i = i + 1
						end
						ps, pw = "[", ""
					elseif string.find(c, "%d") or (c == "." and string.find(string.sub(line, i + 1, i + 1), "%d")) then
						local _, e = string.find(line, "^0[xX][%x_]+", i)
						if not e then
							_, e = string.find(line, "^%d*%.?%d*", i)
							local _, e2 = string.find(line, "^[eE][%+%-]?%d+", e + 1)
							if e2 then e = e2 end
						end
						add(i, e, 4)
						i = e + 1
						ps, pw = "0", ""
					elseif c == "." then
						if string.sub(line, i + 1, i + 1) == "." then
							local e = (string.sub(line, i + 2, i + 2) == ".") and (i + 2) or (i + 1)
							add(i, e, 0)
							i = e + 1
							ps, pw = "..", ""
						else
							add(i, i, 0)
							i = i + 1
							ps, pw = ".", ""
						end
					elseif string.find(c, "[%a_]") then
						local _, e = string.find(line, "^[%w_]+", i)
						local word = string.sub(line, i, e)
						local isCall = string.find(line, "^%s*%(", e + 1) ~= nil
						local colr = 0
						if ps == "." or ps == ":" then
							if isCall then colr = 6 end
						elseif KEYWORDS[word] then colr = 1
						elseif pw == "function" then colr = 6
						elseif BUILTINS[word] then colr = 5
						elseif isCall then colr = 6 end
						add(i, e, colr)
						i = e + 1
						ps, pw = "a", word
					else
						add(i, i, 0)
						i = i + 1
						ps, pw = c, ""
					end
				end
				return cnt, 0
			end

			local function endState(line, state)
				if state == 0 and not string.find(line, "[", 1, true) then return 0 end
				local _, st = tokenize(line, state, false)
				return st
			end

			-- build the rich-text string for one line; ms/me/mst = optional find-match ranges (+ whether it is the current match)
			local function renderLine(line, state, ms, me, mst)
				local cnt = tokenize(line, state, true)
				if cnt == 0 then return "" end
				local out, k, m = {}, 0, 1
				for si = 1, cnt do
					local s, e, c = segS[si], segE[si], segC[si]
					local cur = s
					while cur <= e do
						local stop, marked = e, false
						if ms then
							while m <= #ms and me[m] < cur do m = m + 1 end
							if m <= #ms then
								if ms[m] <= cur then
									marked = true
									stop = math.min(e, me[m])
								elseif ms[m] <= e then
									stop = ms[m] - 1
								end
							end
						end
						local piece = esc(string.sub(line, cur, stop))
						if marked then
							local tag = mst[m] and '<mark color="#FF9F0A" transparency="0.3">' or '<mark color="#FFD60A" transparency="0.65">'
							piece = tag .. piece .. "</mark>"
						end
						if c ~= 0 then piece = '<font color="' .. COL[c] .. '">' .. piece .. "</font>" end
						k = k + 1
						out[k] = piece
						cur = stop + 1
					end
				end
				return table.concat(out)
			end

			local function recomputeAll()
				local st, bytes = 0, 0
				for i = 1, #lines do
					startState[i] = st
					local ln = lines[i]
					bytes = bytes + #ln + 1
					st = endState(ln, st)
				end
				for i = #lines + 1, #startState do startState[i] = nil end
				totalBytes = bytes
			end
			local function recomputeFrom(idx) -- after a single-line edit; stops as soon as the state is stable
				local st = endState(lines[idx], startState[idx] or 0)
				local changed = false
				local i = idx + 1
				while i <= #lines do
					if startState[i] == st then break end
					startState[i] = st
					changed = true
					st = endState(lines[i], st)
					i = i + 1
				end
				return changed
			end

			local GRIP_H = 22
			local wrapF = new("Frame", {
				Size = UDim2.new(1, 0, 0, height + 24 + GRIP_H), LayoutOrder = order, BackgroundTransparency = 1, ZIndex = 5,
			})
			wrapF.Parent = page
			new("TextLabel", {
				Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = "SCRIPT (RAW CODE)",
