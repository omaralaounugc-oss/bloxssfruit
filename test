local Fav = {order = {}, set = {}, binds = {}, hooks = {}} -- order: newest first
function Fav.has(key) return Fav.set[key] == true end
local function favSave()
	pcall(function()
		if writefile then writefile(FAV_FILE, HttpService:JSONEncode(Fav.order)) end
	end)
end
pcall(function()
	if isfile and readfile and isfile(FAV_FILE) then
		for _, k in ipairs(HttpService:JSONDecode(readfile(FAV_FILE))) do
			if type(k) == "string" and not Fav.set[k] then Fav.set[k] = true; table.insert(Fav.order, k) end
		end
	end
end)
function Fav.bind(frame, key, fn) -- every star registers here so they all stay in sync
	Fav.binds[frame] = {key = key, fn = fn}
	return function() Fav.binds[frame] = nil end
end
function Fav.onChange(fn) table.insert(Fav.hooks, fn) end
function Fav.toggle(key, origin)
	local on = not Fav.set[key]
	if on then
		Fav.set[key] = true
		table.insert(Fav.order, 1, key)
	else
		Fav.set[key] = nil
		local i = table.find(Fav.order, key)
		if i then table.remove(Fav.order, i) end
	end
	favSave()
	for frame, b in pairs(Fav.binds) do
		if b.key == key then b.fn(on, frame == origin) end
	end
	for _, h in ipairs(Fav.hooks) do h() end
end
-- resolve saved keys ("Game|Script name") back to the scripts in the list above
local function favList()
	local out = {}
	for _, key in ipairs(Fav.order) do
		local g, n = key:match("^(.-)|(.+)$")
		for _, sc in ipairs(Scripts[g] or {}) do
			if sc.Name == n then table.insert(out, {sc = sc, game = g}) break end
		end
	end
	return out
end

