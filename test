--// verification
local function checkKey(key)
	if #key > 128 then return false, "format", CONFIG.KeyHint end
	if CONFIG.KeyPattern and not key:match(CONFIG.KeyPattern) then
		return false, "format", CONFIG.KeyHint
	end
	if CONFIG.Mode == "remote" then
		local req = K.httpReq()
		if not req then return false, "network", "This executor has no HTTP support" end
		local nonce = HttpService:GenerateGUID(false)
		local payload = HttpService:JSONEncode({
			key = key, hwid = HWID_FULL, userId = lp.UserId, username = lp.Name, placeId = game.PlaceId,
			gameId = game.GameId, executor = getExecutor(), version = CONFIG.Version, nonce = nonce, ts = os.time(),
		})
		local headers = {["Content-Type"] = "application/json"}
		for hk, hv in pairs(CONFIG.Api.Headers or {}) do headers[hk] = hv end
		local done, res = false, nil
		task.spawn(function()
			local ok, r = pcall(req, {Url = CONFIG.Api.Url, Method = "POST", Headers = headers, Body = payload})
			if ok then res = r end
			done = true
		end)
		local t0 = os.clock()
		while not done and os.clock() - t0 < (CONFIG.Api.Timeout or 10) do task.wait(0.05) end
		if not done then return false, "network", "Server took too long - try again" end
		if not res then return false, "network", "Can't reach the key server" end
		local status = tonumber(res.StatusCode)
		K.dbg("verify http", status)
		if status == 429 then return false, "rate_limited" end
		local serverErr = (status and status >= 500) and ("Server error (" .. status .. ") - try again") or nil
		if type(res.Body) ~= "string" or res.Body == "" then
			return false, "network", serverErr or "Can't reach the key server"
		end
		local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
		if not ok or type(data) ~= "table" then
			return false, "network", serverErr or "Unexpected server response"
		end
		if CONFIG.Api.RequireNonce and data.nonce ~= nonce then return false, "bad_response" end
		if data.valid == true or data.success == true then
			local exp = tonumber(data.expires)
			local inSecs = tonumber(data.expires_in)
			if inSecs then exp = os.time() + inSecs end
			return true, {key = key, tier = K.clip(data.tier or "Premium", 24), expires = exp, script = data.script, hwid = HWID_FULL}
		end
		return false, tostring(data.code or "invalid"), data.message and K.clip(data.message, 90) or nil
	end
	local up = key:upper()
	for _, v in ipairs(CONFIG.Keys) do
		local k = type(v) == "table" and v.key or v
		if up == tostring(k):upper() then
			local exp = type(v) == "table" and v.expires or nil
			if exp and exp <= os.time() then return false, "expired" end
			return true, {key = key, tier = type(v) == "table" and v.tier or "Premium", expires = exp, hwid = HWID_FULL}
		end
	end
	return false, "invalid"
end

