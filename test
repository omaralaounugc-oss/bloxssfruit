--// Fade helpers (no CanvasGroup)
local tracked = {}
local function track(root)
	local list = root:GetDescendants()
	table.insert(list, root)
	for _, d in ipairs(list) do
		local rec = {}
		if d:IsA("GuiObject") then rec.BackgroundTransparency = d.BackgroundTransparency end
		if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
			rec.TextTransparency = d.TextTransparency
			rec.TextStrokeTransparency = d.TextStrokeTransparency
		end
		if d:IsA("ImageLabel") then rec.ImageTransparency = d.ImageTransparency end
		if d:IsA("UIStroke") then rec.Transparency = d.Transparency end
		if next(rec) then tracked[d] = rec end
	end
end
local function fadeObj(d, visible, t, delay)
	local rec = tracked[d]
	if not rec then return end
	local goal = {}
	for prop, val in pairs(rec) do goal[prop] = visible and val or 1 end
	task.delay(delay or 0, function()
		if d.Parent then tween(d, t, goal) end
	end)
end
local function fadeTree(root, visible, t, delay)
	fadeObj(root, visible, t, delay)
	for _, d in ipairs(root:GetDescendants()) do fadeObj(d, visible, t, delay) end
end
local function hideTree(root)
	local list = root:GetDescendants()
	table.insert(list, root)
	for _, d in ipairs(list) do
		local rec = tracked[d]
		if rec then for prop in pairs(rec) do d[prop] = 1 end end
	end
end

