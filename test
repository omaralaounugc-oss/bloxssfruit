--// Notifications: one spring-driven banner (iOS-style motion)
local RunService = game:GetService("RunService")
local LOGO_IMAGE -- filled in once the logo image resolves

local function chime(on)
	-- one clean tick, like the iOS switch (no more ping arpeggio)
	play(on and "on" or "off")
end

local toast, toastIcon, toastTitle, toastSub, toastTag, toastTagLabel, toastScale
local fadeList = {}
local toastToken = 0
local SHOWN_Y, HIDDEN_Y = 4, -80

-- spring state: position, scale, opacity
local S = {y = HIDDEN_Y, vy = 0, s = 0.9, vs = 0, a = 0, va = 0,
	ty = HIDDEN_Y, ts = 0.9, ta = 0, k = 230, d = 21}
local springConn

local function stepSpring(x, v, target, k, d, h)
	v += (-k * (x - target) - d * v) * h
	x += v * h
	return x, v
end

local function applyAlpha(a)
	for _, e in ipairs(fadeList) do
		e[1][e[2]] = 1 - (1 - e[3]) * a
	end
end

local function startLoop()
	if springConn then return end
	springConn = RunService.Heartbeat:Connect(function(dt)
		dt = math.min(dt, 1 / 30)
		for _ = 1, 2 do
			local h = dt / 2
			S.y, S.vy = stepSpring(S.y, S.vy, S.ty, S.k, S.d, h)
			S.s, S.vs = stepSpring(S.s, S.vs, S.ts, S.k, S.d, h)
			S.a, S.va = stepSpring(S.a, S.va, S.ta, 320, 36, h)
		end
		if toast and toast.Parent then
			toast.Position = UDim2.new(1, -12, 0, S.y)
			toastScale.Scale = math.max(S.s, 0.01)
			applyAlpha(math.clamp(S.a, 0, 1))
		end
		if math.abs(S.y - S.ty) < 0.15 and math.abs(S.vy) < 0.5
			and math.abs(S.s - S.ts) < 0.002 and math.abs(S.a - S.ta) < 0.01 then
			if S.ta == 0 and toast then toast.Visible = false end
			springConn:Disconnect()
			springConn = nil
		end
	end)
end

