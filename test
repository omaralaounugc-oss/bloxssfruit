local function pickFont(name, fallback)
	local ok, f = pcall(function() return Enum.Font[name] end)
	if ok and f then return f end
	return fallback
end
local F_XBOLD = Enum.Font.GothamBlack
local F_BOLD  = Enum.Font.GothamBold
local F_SEMI  = Enum.Font.GothamMedium
local F_REG   = Enum.Font.Gotham

-- Professional typography: Inter (clean, SF-style). Falls back to Gotham if unavailable.
local FONT_FAMILY = "rbxasset://fonts/families/Inter.json"
local function interFace(weight)
	local ok, f = pcall(function() return Font.new(FONT_FAMILY, weight, Enum.FontStyle.Normal) end)
	return ok and f or nil
end
local FACES = {
	[F_XBOLD] = interFace(Enum.FontWeight.Bold),
	[F_BOLD]  = interFace(Enum.FontWeight.SemiBold),
	[F_SEMI]  = interFace(Enum.FontWeight.Medium),
	[F_REG]   = interFace(Enum.FontWeight.Regular),
}
-- apply a font to any text object, using Inter when available
local function setFont(inst, f)
	local face = FACES[f]
	if face then
		local ok = pcall(function() inst.FontFace = face end)
		if ok then return end
	end
	inst.Font = f
end

