local function flashStatus(msg, col, secs)
	statusToken = statusToken + 1
	local my = statusToken
	statusLbl.Text = msg
	statusLbl.TextColor3 = col or C.Accent
	task.delay(secs or 2.5, function()
		if alive and statusToken == my then statusLbl.Text = baseMsg; statusLbl.TextColor3 = baseCol end
	end)
end

local locked, lockUntil, fails = false, 0, 0
local function refreshUnlock()
	if busy or closing then return end
	if locked then
		unlockBtn.BackgroundColor3 = C.Capsule
		unlockBtn.TextColor3 = C.Secondary
		return
	end
	local has = keyBox.Text ~= ""
	tween(unlockBtn, 0.25, {BackgroundColor3 = (has or clipKey) and C.Accent or C.AccentDim})
	unlockBtn.TextColor3 = C.Ink
	unlockBtn.Text = (not has and clipKey) and "Paste & Unlock" or "Unlock"
	pasteBtn.Text = has and "Clear" or "Paste"
	pasteBtn.TextColor3 = has and C.Secondary or C.Accent
end

function K.startLock(secs)
	locked, lockUntil = true, os.clock() + secs
	task.spawn(function()
		while alive and locked do
			local left = math.ceil(lockUntil - os.clock())
			if left <= 0 then break end
			unlockBtn.Text = "Try again in " .. (left >= 60 and string.format("%d:%02d", math.floor(left / 60), left % 60) or (left .. "s"))
			setStatus("Too many wrong keys", C.Red, C.Red, "Locked")
			refreshUnlock()
			task.wait(0.5)
		end
		locked = false
		if alive then
			setStatus("You can try again", C.Secondary, C.Green, "Ready")
			refreshUnlock()
		end
	end)
end

