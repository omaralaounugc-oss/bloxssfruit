	local root, centerScale, pulse, shimmer, fill, status, img
	local continueBtn, ready, continued = nil, false, false
	local enabled = SHOW_LOADING ~= false

	local function fadeOut(o, t)
		for _, d in ipairs(o:GetDescendants()) do
			local goal = {}
			if d:IsA("GuiObject") then goal.BackgroundTransparency = 1 end
			if d:IsA("TextLabel") or d:IsA("TextButton") then goal.TextTransparency = 1 end
			if d:IsA("ImageLabel") then goal.ImageTransparency = 1 end
			if d:IsA("UIStroke") then goal.Transparency = 1 end
			if next(goal) then tween(d, t, goal) end
		end
		tween(o, t, {BackgroundTransparency = 1})
	end

	local function setStatus(txt)
		if not status or status.Text == txt then return end
		status.Text = txt
		status.TextTransparency = 0.8
		tween(status, 0.35, {TextTransparency = 0})
	end

