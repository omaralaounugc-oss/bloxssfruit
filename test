			fullBtn = headerBtn("Full", 298, enterFull, 40, 11)

			-- ===== ROBLOX OUTPUTS (full screen only): live prints / warnings / errors, copy them or save them to your workspace =====
			do
				local TAG = {print = "PRINT", info = "INFO", warn = "WARN", error = "ERROR"}
				local HEX = {print = "#E8E8EC", info = "#8A8A92", warn = "#FFD60A", error = "#FF453A"}
				local show = {print = true, info = true, warn = true, error = true}
				local MAX_SHOWN = 250 -- lines drawn at once (the full log is still kept for Copy / Download)
				local RED = Color3.fromRGB(255, 69, 58)

				local outBar = new("ScrollingFrame", {
					Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 4), BackgroundTransparency = 1,
					BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(),
					AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X, ZIndex = 41,
				}, { new("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center,
				}) })
				outBar.Parent = outPanel
				local outScroll = new("ScrollingFrame", {
					Size = UDim2.new(1, -12, 1, -38), Position = UDim2.fromOffset(6, 32), BackgroundTransparency = 1,
					BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageTransparency = 0.5, CanvasSize = UDim2.new(),
					AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 41,
				}, { new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3)}) })
				outScroll.Parent = outPanel

				local function outBtnMake(order, text, col)
					local b = new("TextButton", {
						Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = order,
						BackgroundColor3 = col, BackgroundTransparency = 0.82, BorderSizePixel = 0, AutoButtonColor = false,
						Text = text, Font = F_SEMI, TextSize = 11, TextColor3 = col, ZIndex = 42,
					}, { round(6), new("UIPadding", {PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9)}) })
					b.Parent = outBar
					return b
				end

				-- filter chips: tap to hide / show that kind of line (they also show the live counts)
				local chips = {}
				local function mkChip(order, label, col, kinds, getN)
					local b = outBtnMake(order, label, col)
					local rec = {b = b, label = label, col = col, kinds = kinds, getN = getN}
					chips[#chips + 1] = rec
					return rec
				end
				mkChip(1, "Errors", RED, {"error"}, function() return Outputs.counts.error end)
				mkChip(2, "Warns", C.Gold, {"warn"}, function() return Outputs.counts.warn end)
				mkChip(3, "Prints", Color3.fromRGB(232, 232, 236), {"print", "info"}, function() return Outputs.counts.print + Outputs.counts.info end)
				local function paintChips()
					for _, r in ipairs(chips) do
						local on = show[r.kinds[1]]
						r.b.Text = r.label .. " " .. r.getN()
						r.b.TextColor3 = on and r.col or C.Secondary
						r.b.BackgroundColor3 = on and r.col or Color3.new(1, 1, 1)
						r.b.BackgroundTransparency = on and 0.85 or 0.94
					end
				end

				local shown = {}
				local function outEsc(s)
					s = string.gsub(s, "[\1-\8\11-\31]", "")
					s = string.gsub(s, "&", "&amp;")
					s = string.gsub(s, "<", "&lt;")
					s = string.gsub(s, ">", "&gt;")
					s = string.gsub(s, '"', "&quot;")
					s = string.gsub(s, "'", "&apos;")
					return s
				end
				local function addLabel(e)
					local txt = e.text
					if #txt > 1500 then txt = string.sub(txt, 1, 1500) .. " ... (cut here, the full text is in Copy / Download)" end
					local col = HEX[e.kind]
					local l = new("TextLabel", {
						Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = e.id,
						BackgroundTransparency = 1, RichText = true, TextWrapped = true, Font = Enum.Font.Code, TextSize = 12,
						TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
						TextColor3 = TXT, ZIndex = 42,
						Text = '<font color="#6E6E76">' .. e.time .. '</font> <font color="' .. col .. '"><b>' .. TAG[e.kind]
							.. '</b>  ' .. outEsc(txt) .. '</font>',
					})
					l.Parent = outScroll
					shown[#shown + 1] = l
					if #shown > MAX_SHOWN then table.remove(shown, 1):Destroy() end
				end
				local function toBottom()
					task.defer(function()
						task.wait()
						if outScroll.Parent then outScroll.CanvasPosition = Vector2.new(0, 1e6) end
					end)
				end
				local function outRefresh()
					for _, l in ipairs(shown) do l:Destroy() end
					table.clear(shown)
					local pick, list = {}, Outputs.list
					for i = #list, 1, -1 do -- newest first, stop once the box is full
						if show[list[i].kind] then
							pick[#pick + 1] = list[i]
							if #pick >= MAX_SHOWN then break end
						end
					end
					for i = #pick, 1, -1 do addLabel(pick[i]) end
					paintChips()
					toBottom()
				end
				for _, r in ipairs(chips) do
					r.b.MouseButton1Click:Connect(function()
						play("click")
						buzz(0.5, 0.04)
						local on = not show[r.kinds[1]]
						for _, k in ipairs(r.kinds) do show[k] = on end
						outRefresh()
					end)
				end

				-- new lines arrive in bursts (a loop can print hundreds a second), so draw them in small batches
				local pending = {}
				table.insert(Outputs.subs, function(e) pending[#pending + 1] = e end)
				task.spawn(function()
					while gui.Parent do
						task.wait(0.25)
						if #pending > 0 then
							local batch = pending
							pending = {}
							if outPanel.Visible then
								local stick = outScroll.AbsoluteCanvasSize.Y - outScroll.AbsoluteWindowSize.Y - outScroll.CanvasPosition.Y < 40
								for i = math.max(1, #batch - MAX_SHOWN + 1), #batch do
									if show[batch[i].kind] then addLabel(batch[i]) end
								end
								if stick then toBottom() end
							end
							paintChips()
						end
					end
				end)

				local function buildText(onlyErrors)
					local out = {
						"WOWHUB - Roblox Output",
						"Date: " .. os.date("%Y-%m-%d %H:%M:%S"),
						"Executor: " .. getExecutorName(),
						"PlaceId: " .. tostring(game.PlaceId),
						"Errors: " .. Outputs.counts.error .. "  Warnings: " .. Outputs.counts.warn
							.. "  Prints: " .. (Outputs.counts.print + Outputs.counts.info),
						string.rep("-", 40),
					}
					for _, e in ipairs(Outputs.list) do
						if not onlyErrors or e.kind == "error" then
							out[#out + 1] = "[" .. e.time .. "] [" .. TAG[e.kind] .. "] " .. e.text
						end
					end
					return table.concat(out, "\n")
				end
				local function flash(b, text, idle)
					b.Text = text
					task.delay(1.3, function() if b.Parent then b.Text = idle end end)
				end
				local function doCopy(onlyErrors, b, idle)
					if #Outputs.list == 0 or (onlyErrors and Outputs.counts.error == 0) then
						notify("Roblox Outputs", onlyErrors and "No errors detected" or "Nothing to copy yet", nil, "EMPTY")
						return
					end
					local fn = setclipboard or toclipboard or (syn and syn.write_clipboard)
					if not fn then notify("Roblox Outputs", "Your executor can't copy to the clipboard", false, "ERROR") return end
					pcall(fn, buildText(onlyErrors))
					notify("Roblox Outputs", onlyErrors and "Errors copied" or "Output copied", true, "COPIED")
					flash(b, "Copied", idle)
				end

				local bCopy = outBtnMake(4, "Copy", C.Blue)
				bCopy.MouseButton1Click:Connect(function() play("click") buzz(0.5, 0.04) doCopy(false, bCopy, "Copy") end)
				local bErr = outBtnMake(5, "Copy errors", C.Blue)
				bErr.MouseButton1Click:Connect(function() play("click") buzz(0.5, 0.04) doCopy(true, bErr, "Copy errors") end)
				local bSave = outBtnMake(6, "Download", C.Blue)
				bSave.MouseButton1Click:Connect(function()
					play("click")
					buzz(0.5, 0.04)
					if not writefile then notify("Roblox Outputs", "Your executor can't save files", false, "ERROR") return end
					if #Outputs.list == 0 then notify("Roblox Outputs", "Nothing to save yet", nil, "EMPTY") return end
					local name = "WOWHUB_Output_" .. os.date("%Y-%m-%d_%H-%M-%S") .. ".txt"
					if pcall(writefile, name, buildText(false)) then
						notify("Roblox Outputs", "Saved to workspace: " .. name, true, "SAVED")
						flash(bSave, "Saved", "Download")
					else
						notify("Roblox Outputs", "Could not save the file", false, "ERROR")
					end
				end)
				local bClear = outBtnMake(7, "Clear", C.Blue)
				bClear.MouseButton1Click:Connect(function()
					play("click")
					buzz(0.5, 0.04)
					table.clear(Outputs.list)
					for k in pairs(Outputs.counts) do Outputs.counts[k] = 0 end
					table.clear(pending)
					outRefresh()
					notify("Roblox Outputs", "Output cleared", nil, "CLEARED")
				end)

				-- the "Output" button in the editor's top bar (only visible in full screen, next to File / Find / Copy / Clear)
				outBtn = headerBtn("Output", 198, function()
					if outPanel.Visible then
						outPanel.Visible = false
					else
						closeOverlays()
						outPanel.Visible = true
						outRefresh()
					end
				end, 56, 11)
				outBtn.Visible = false
				outPanel:GetPropertyChangedSignal("Visible"):Connect(function()
					outBtn.BackgroundTransparency = outPanel.Visible and 0.55 or 0.82
				end)
				paintChips()
			end
			exitBtn.MouseButton1Click:Connect(function()
				play("click")
				buzz(0.5, 0.04)
				exitFull()
			end)
			gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
				if fullscreen then task.delay(0.15, layoutFull) end
			end)

			do
				local gDrag, gInput, gStartY, gStartH, gScale = false, nil, 0, 0, 1
				local function gripVisual(on)
					tween(gripPill, 0.15, {BackgroundTransparency = on and 0.05 or 0.7, BackgroundColor3 = on and C.Blue or Color3.new(1, 1, 1),
						Size = UDim2.fromOffset(on and 84 or 56, 5)})
					pcall(function() page.ScrollingEnabled = not on end)
				end
				grip.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						gDrag, gInput, gStartY, gStartH = true, input, input.Position.Y, height
						gScale = math.max(field.AbsoluteSize.Y / math.max(height, 1), 0.01)
						buzz(0.5, 0.04)
						gripVisual(true)
					end
				end)
				UIS.InputChanged:Connect(function(input)
					if gDrag and (input == gInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
						applyHeight(gStartH + (input.Position.Y - gStartY) / gScale)
					end
				end)
				UIS.InputEnded:Connect(function(input)
					if gDrag and (input == gInput or input.UserInputType == Enum.UserInputType.MouseButton1) then
						gDrag, gInput = false, nil
						gripVisual(false)
					end
				end)
			end

			-- ===== CORNER GRIP: drag the arc in the bottom-right corner of the editor to change its width (and height) =====
			do
				local MIN_W = 360        -- the header buttons need this much room
				local KEEP_RIGHT = 40    -- always leave a strip on the right so you can still swipe the page
				local CG_W, CG_H = 40, 32
				cornerGrip = new("TextButton", {
					Name = "EditorCornerGrip", Size = UDim2.fromOffset(CG_W, CG_H), AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false,
					Text = "", ZIndex = 30,
				})
				-- the arc: a circle outline whose centre sits on the editor's rounded corner; the clip frame shows only the corner quarter
				local arcClip = new("Frame", {
					Size = UDim2.fromOffset(16, 16), Position = UDim2.new(1, -21, 1, -21), BackgroundTransparency = 1,
					BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 31, Active = false,
				})
				arcClip.Parent = cornerGrip
				local arcStroke = new("UIStroke", {Color = C.Blue, Thickness = 3.5, Transparency = 0.1,
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
				new("Frame", {
					Size = UDim2.fromOffset(26, 26), Position = UDim2.fromOffset(-13, -13), BackgroundTransparency = 1,
					BorderSizePixel = 0, ZIndex = 31,
				}, { pill(), arcStroke }).Parent = arcClip
				cornerGrip.Parent = field

				local function unitScale() return math.max(field.AbsoluteSize.Y / math.max(height, 1), 0.01) end
				local function maxW(sc) return math.max(MIN_W, page.AbsoluteSize.X / (sc or unitScale()) - KEEP_RIGHT) end
				local function applyWidth(w, sc) -- sc: UI scale measured when the drag started (stays steady while the editor resizes)
					if fullscreen then return end
					sc = sc or unitScale()
					w = math.clamp(math.floor(w + 0.5), MIN_W, maxW(sc))
					local wrapW = wrapF.AbsoluteSize.X / sc
					if math.abs(w - wrapW) <= 8 then normalW = nil else normalW = w end -- snaps back to the default width
					field.Size = fieldSize(height)
					layoutNarrow(normalW or wrapW)
				end
				-- narrow editor: hide the file name and shorten the status text so nothing overlaps
				layoutNarrow = function(wu)
					if not wu then
						if field.AbsoluteSize.Y < 1 or wrapF.AbsoluteSize.X < 1 then return end
						wu = normalW or (wrapF.AbsoluteSize.X / unitScale())
					end
					nameLbl.Visible = wu >= 440
					local c = wu < 430
					if c ~= compact then compact = c updateInfo() end
				end
				-- if the hub window gets smaller, keep the editor inside it
				wrapF:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
					if fullscreen or field.AbsoluteSize.Y < 1 then return end
					if normalW then
						local mx = maxW()
						if normalW > mx then
							normalW = mx
							field.Size = fieldSize(height)
						end
					end
					layoutNarrow()
				end)

				local cDrag, cInput, cStart, cStartW, cStartH, cScale = false, nil, nil, 0, 0, 1
				local lastTickAt, lastTickW, lastTickH, atLimit = 0, 0, 0, false
				local function cornerVisual(on)
					tween(arcStroke, 0.15, {Color = on and Color3.new(1, 1, 1) or C.Blue, Transparency = on and 0 or 0.1})
					pcall(function() page.ScrollingEnabled = not on end)
				end
				cornerGrip.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						cDrag, cInput, cStart = true, input, input.Position
						cScale = unitScale()
						cStartW, cStartH = field.AbsoluteSize.X / cScale, height
						lastTickAt, lastTickW, lastTickH, atLimit = 0, cStartW, cStartH, false
						play("grab"); buzz(0.5, 0.04)
						cornerVisual(true)
					end
				end)
				UIS.InputChanged:Connect(function(input)
					if cDrag and (input == cInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
						local dx, dy = (input.Position.X - cStart.X) / cScale, (input.Position.Y - cStart.Y) / cScale
						local tw, th = cStartW + dx, cStartH + dy
						applyWidth(tw, cScale)
						applyHeight(th)
						-- soft detent tick while dragging, firmer thud at the size limits
						local w = field.AbsoluteSize.X / cScale
						if (math.abs(w - lastTickW) + math.abs(height - lastTickH)) >= 26 and os.clock() - lastTickAt > 0.05 then
							play("tick", (w + height) > (lastTickW + lastTickH) and 1.5 or 1.3)
							lastTickAt, lastTickW, lastTickH = os.clock(), w, height
						end
						local clamped = tw <= MIN_W or tw >= maxW(cScale) or th <= MIN_H or th >= MAX_H
						if clamped and not atLimit then play("limit"); buzz(0.35, 0.05) end
						atLimit = clamped
					end
				end)
				UIS.InputEnded:Connect(function(input)
					if cDrag and (input == cInput or input.UserInputType == Enum.UserInputType.MouseButton1) then
						cDrag, cInput = false, nil
						play("drop"); buzz(0.2, 0.05)
						cornerVisual(false)
					end
				end)
			end

			recomputeAll()
			relayout()

			local obj = {}
			function obj.get() return table.concat(lines, "\n") end
			function obj.count() return #lines end
			function obj.set(text)
				lines = split(text)
				posLbl.Text = "Ln 1, Col 1"
				lastFirst = -1
				scroll.CanvasPosition = Vector2.new(0, 0)
				recomputeAll()
				relayout()
				fire()
			end
			function obj.clear() obj.set("") end
			function obj.onChange(fn) changeFn = fn end
			function obj.setError(on)
				if on then
					tween(stroke, 0.2, {Transparency = 0.1, Color = Color3.fromRGB(255, 69, 58)})
				else
					tween(stroke, 0.25, {Transparency = 0.9, Color = Color3.new(1, 1, 1)})
				end
			end
			return obj
		end

		-- full-width button (primary = accent colour, secondary = grey). Returns the button.
