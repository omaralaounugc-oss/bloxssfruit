			local posLbl = new("TextLabel", {
				Size = UDim2.new(0, 130, 0, STAT_H), Position = UDim2.new(0, 12, 1, -STAT_H), BackgroundTransparency = 1,
				Text = "Ln 1, Col 1", Font = Enum.Font.Code, TextSize = 12, TextColor3 = C.Secondary,
				TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7,
			})
			posLbl.Parent = field
			local infoLbl = new("TextLabel", {
				Size = UDim2.new(1, -176, 0, STAT_H), Position = UDim2.new(0, 142, 1, -STAT_H), BackgroundTransparency = 1,
				Text = "", Font = Enum.Font.Code, TextSize = 12, TextColor3 = C.Secondary,
				TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 7,
			})
			infoLbl.Parent = field
			local compact = false -- narrow editor: shorter status text
			local layoutNarrow = function() end -- defined with the corner grip below
			local function updateInfo()
				if compact then
					infoLbl.Text = string.format("%d lines - %.1f KB", #lines, totalBytes / 1024)
				else
					infoLbl.Text = string.format("%d lines  -  %.1f KB  -  Lua", #lines, totalBytes / 1024)
				end
