		-- "Recently used" list: rebuilt whenever a script is executed; tap a row to run it again
		function api.recent(getList, run)
			local _, grp = api.section("Recently used")
			local function rebuild()
				for _, ch in ipairs(grp:GetChildren()) do
					if ch:IsA("GuiObject") then
						for _, d in ipairs(ch:GetDescendants()) do tracked[d] = nil end
						tracked[ch] = nil
						ch:Destroy()
					end
				end
				local saved = group
				group, rowCount = grp, 0
				local list = getList()
				if #list == 0 then
					local row = baseRow("Scripts you run show up here")
					local t = row:FindFirstChildOfClass("TextLabel")
					t.Size = UDim2.new(1, -32, 1, 0)
					t.TextColor3 = C.Secondary
					setFont(t, F_REG)
					pcall(function() row.Interactable = false end)
					track(row)
				else
					for _, e in ipairs(list) do
						local row = baseRow(e.sc.Name)
						local t = row:FindFirstChildOfClass("TextLabel")
						t.TextTruncate = Enum.TextTruncate.AtEnd
						new("TextLabel", {
							Size = UDim2.new(0.3, 0, 1, 0), Position = UDim2.new(1, -16, 0, 0),
							AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, Text = e.game,
							Font = F_REG, TextSize = 13, TextColor3 = C.Secondary,
							TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd,
							ZIndex = 8,
						}).Parent = row
						row.MouseButton1Click:Connect(function()
							play("click")
							buzz(0.7, 0.05)
							task.spawn(run, e)
						end)
						track(row)
					end
				end
				group = saved
			end
			Recent.onChange(rebuild)
			rebuild()
		end

