-- restore a cooldown that was still running when the script was last closed
if CONFIG.PersistLock ~= false then
	local untilT, lvl = tostring(K.read(CONFIG.LockFile) or ""):match("^(%d+)|(%d+)$")
	untilT, lvl = tonumber(untilT), tonumber(lvl)
	if untilT and lvl then
		local now = os.time()
		if untilT > now then K.lockLevel = lvl; K.startLock(untilT - now)
		elseif now - untilT < 3600 then K.lockLevel = lvl
		else K.delete(CONFIG.LockFile) end
	end
end

