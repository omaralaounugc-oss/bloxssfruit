		settingsPage.toggle("FPS Booster", Cfg.fpsBooster == true, function(on)
			Cfg.fpsBooster = on; saveCfg()
			task.spawn(setBooster, on)
		end)


		-- OP FPS Boost: the strong optimizer (flags + full map strip). Everything it changes is remembered and restored when switched off.
		local OP_FFLAGS = {
			DFIntTaskSchedulerTargetFps = "9999",
			FFlagTaskSchedulerLimitTargetFpsToDevice = "False",
			FFlagGameBasicSettingsFramerateCap5 = "False",
			FFlagEnableTextureStreaming = "True",
			DFFlagTextureQualityOverrideEnabled = "True",
			DFIntTextureQualityOverride = "0",
			FIntDebugTextureManagerSkipMips = "8",
			FIntDebugForceMSAASamples = "0",
			FIntDebugFRMOptionalMSAALevelOverride = "0",
			DFIntDebugFRMQualityLevelOverride = "1",
			FFlagDisablePostFx = "True",
			FIntRenderShadowIntensity = "0",
			FIntRenderLocalLightUpdatesMax = "1",
			FIntRenderGrassHeightScalar = "0",
			FIntFRMMinGrassDistance = "0",
			FIntGrassMovementReducedMotionFactor = "0",
			FFlagGlobalWindRendering = "False",
			FFlagGlobalWindActivated = "False",
			DFIntCSGLevelOfDetailSwitchingDistance = "0",
			DFIntCSGLevelOfDetailSwitchingDistanceL12 = "0",
			DFIntCSGLevelOfDetailSwitchingDistanceL23 = "0",
			DFIntCSGLevelOfDetailSwitchingDistanceL34 = "0",
			DFIntCSGLevelOfDetailSwitchingDistanceStatic = "0",
			DFFlagDebugSkipMeshVoxelizer = "True",
			DFFlagDebugPerfMode = "True",
			FFlagFastGPULightCulling3 = "True",
			FFlagDebugForceFSMCPULightCulling = "True",
			FFlagMSRendererLightGridOptimization = "True",
			DFFlagLightGridSimdNew3 = "True",
			FFlagLuauCodegen = "True",
			FFlagLuauCodegenFull = "True",
			FFlagOptimizePhysCollide = "True",
			FFlagSortPhysicsCollisionGroups = "True",
			FFlagNewOptimizeNoCollisionPrimitiveInMidphase660 = "True",
			DFIntMaxFrameBufferSize = "4",
		}
		local function applyFFlags()
			local fn
			for _, name in ipairs({"setfflag", "setfastflag", "set_fflag", "setFFlag", "fflag"}) do
				local f = (getgenv and getgenv()[name]) or rawget(getfenv(), name)
				if type(f) == "function" then fn = f break end
			end
			if not fn then return 0 end
			local n = 0
			for k, v in pairs(OP_FFLAGS) do
				if pcall(fn, k, v) then n += 1 end
			end
			return n
		end

		local OP = {on = false, token = 0, count = 0}
		local opSaved = setmetatable({}, {__mode = "k"}) -- inst -> {prop = original value}
		local opRemoved = {}                              -- {inst, parent} for removed SurfaceAppearances
		local opConn
		local OP_SKIP = {WOWHUB_Blur = true}

		local function opSet(inst, prop, val)
			local ok, cur = pcall(function() return inst[prop] end)
			if not ok or cur == val then return end
			local rec = opSaved[inst]
			if not rec then rec = {} opSaved[inst] = rec end
			if rec[prop] == nil then rec[prop] = cur end
			pcall(function() inst[prop] = val end)
		end

		local function opHandle(d)
			if d:IsA("BasePart") then
				if d:IsA("Terrain") then return end
				opSet(d, "Material", Enum.Material.SmoothPlastic)
				opSet(d, "Reflectance", 0)
				opSet(d, "CastShadow", false)
				if d:IsA("MeshPart") then
					opSet(d, "RenderFidelity", Enum.RenderFidelity.Performance)
					opSet(d, "TextureID", "")
				end
			elseif d:IsA("Decal") or d:IsA("Texture") then
				opSet(d, "Transparency", 1)
			elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Smoke")
				or d:IsA("Fire") or d:IsA("Sparkles") or d:IsA("Highlight") then
				opSet(d, "Enabled", false)
			elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
				opSet(d, "Shadows", false)
			elseif d:IsA("SurfaceAppearance") then
				table.insert(opRemoved, {d, d.Parent})
				pcall(function() d.Parent = nil end)
			end
			OP.count += 1
		end

		local function opEffect(e)
			if OP_SKIP[e.Name] then return end
			if e:IsA("BloomEffect") or e:IsA("BlurEffect") or e:IsA("ColorCorrectionEffect")
				or e:IsA("DepthOfFieldEffect") or e:IsA("SunRaysEffect") then
				opSet(e, "Enabled", false)
			elseif e:IsA("Atmosphere") then
				opSet(e, "Density", 0)
				opSet(e, "Haze", 0)
				opSet(e, "Glare", 0)
			elseif e:IsA("Clouds") then
				opSet(e, "Enabled", false)
			end
		end

		local function opDisable()
			OP.token += 1
			OP.on = false
			if opConn then opConn:Disconnect() opConn = nil end
			for inst, rec in pairs(opSaved) do
				for prop, val in pairs(rec) do pcall(function() inst[prop] = val end) end
			end
			opSaved = setmetatable({}, {__mode = "k"})
			for _, r in ipairs(opRemoved) do
				if r[2] and r[2].Parent then pcall(function() r[1].Parent = r[2] end) end
			end
			opRemoved = {}
			pcall(function() if setfpscap then setfpscap(60) end end)
			pcall(function() settings().Rendering.QualityLevel = origQuality or Enum.QualityLevel.Automatic end)
		end

		local function opEnable()
			OP.token += 1
			local my = OP.token
			OP.on, OP.count = true, 0
			task.spawn(function()
				local okf, flags = pcall(applyFFlags)
				flags = okf and flags or 0
				pcall(function() if setfpscap then setfpscap(999) end end)

				-- rendering settings
				pcall(function()
					origQuality = origQuality or settings().Rendering.QualityLevel
					settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
				end)
				pcall(function() settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04 end)

				-- lighting + post effects
				opSet(Lighting, "GlobalShadows", false)
				opSet(Lighting, "ShadowSoftness", 0)
				opSet(Lighting, "EnvironmentDiffuseScale", 0)
				opSet(Lighting, "EnvironmentSpecularScale", 0)
				pcall(function() if sethiddenproperty then sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility) end end)
				for _, e in ipairs(Lighting:GetDescendants()) do opEffect(e) end
				if cam() then for _, e in ipairs(cam():GetChildren()) do opEffect(e) end end

				-- terrain: no grass/decoration, flat water
				local terrain = workspace:FindFirstChildOfClass("Terrain")
				if terrain then
					opSet(terrain, "WaterWaveSize", 0)
					opSet(terrain, "WaterWaveSpeed", 0)
					opSet(terrain, "WaterReflectance", 0)
					pcall(function() if sethiddenproperty then sethiddenproperty(terrain, "Decoration", false) end end)
				end

				-- the whole map, in small batches so the game never freezes
				local n = 0
				for _, d in ipairs(workspace:GetDescendants()) do
					if OP.token ~= my then return end
					pcall(opHandle, d)
					n += 1
					if n % 250 == 0 then task.wait() end
				end
				if OP.token ~= my then return end

				-- anything that spawns later gets stripped too
				opConn = workspace.DescendantAdded:Connect(function(d)
					if OP.on then task.defer(function() pcall(opHandle, d) end) end
				end)
				pcall(function() collectgarbage("collect") end)
				notify("OP FPS Boost", OP.count .. " objects optimized" .. (flags > 0 and (", " .. flags .. " flags set") or ""), true)
			end)
		end
		settingsPage.toggle("OP FPS Boost", Cfg.opBoost == true, function(on)
			Cfg.opBoost = on; saveCfg()
			if on then opEnable() else opDisable() end
		end)
		settingsPage.note("OP FPS Boost strips textures, materials, shadows, effects and particles and drops graphics quality to the minimum. Turn it off to restore everything. Flags need an executor with setfflag and some only apply after a rejoin.")

		-- Server
		settingsPage.section("Server")
		settingsPage.button("Rejoin Server", function()
			notify("Rejoin", "Rejoining this server...", nil)
			pcall(function()
				if #Players:GetPlayers() <= 1 then
					lp:Kick("\nRejoining...")
					task.wait()
					Teleport:Teleport(game.PlaceId, lp)
				else
					Teleport:TeleportToPlaceInstance(game.PlaceId, game.JobId, lp)
				end
			end)
		end)
		settingsPage.button("Server Hop", function()
			notify("Server Hop", "Searching for a server...", nil)
			local ok, res = pcall(function()
				return HttpService:JSONDecode(game:HttpGet(
					"https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
			end)
			if ok and res and res.data then
				local pool = {}
				for _, s in ipairs(res.data) do
					if s.id ~= game.JobId and s.playing < s.maxPlayers then table.insert(pool, s.id) end
				end
				if #pool > 0 then
					pcall(function() Teleport:TeleportToPlaceInstance(game.PlaceId, pool[math.random(#pool)], lp) end)
					return
				end
			end
			notify("Server Hop", "No other server found", false)
		end)
		settingsPage.button("Copy Game ID", function()
			if copyLink(tostring(game.PlaceId)) then
				notify("Game ID", "Copied " .. game.PlaceId, true, "COPIED")
			else
				notify("Game ID", tostring(game.PlaceId), nil)
			end
		end)
		settingsPage.button("Copy Server ID", function()
			if copyLink(game.JobId) then
				notify("Server ID", "Copied to clipboard", true, "COPIED")
			else
				notify("Server ID", game.JobId, nil)
			end
		end)

		-- saved heavy toggles come back a moment after the hub opens (the game needs to finish loading first)
		if Cfg.fpsBooster == true or Cfg.opBoost == true then
			task.delay(2, function()
				if Cfg.fpsBooster == true then task.spawn(setBooster, true) end
				if Cfg.opBoost == true then opEnable() end
			end)
		end

		-- closing the hub switches everything off again (your saved choices stay saved)
		gui.Destroying:Connect(function()
			for _, c in ipairs(conns) do c:Disconnect() end
			pcall(opDisable)
			pcall(setBooster, false)
			pcall(setFullbright, false)
			if afkConn then afkConn:Disconnect() end
			if jumpConn then jumpConn:Disconnect() end
			pcall(function() RunService:UnbindFromRenderStep("WOWHUB_FOV") end)
			if fovOn and cam() then cam().FieldOfView = fovDefault end
			if wsOn then
				local ch = lp.Character
				local hum = ch and ch:FindFirstChildOfClass("Humanoid")
