			TextColor3 = i == 1 and Color3.new(1, 1, 1) or C.Secondary,
			TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, ZIndex = 5,
		}, { new("UIPadding", {PaddingLeft = UDim.new(0, 38), PaddingRight = UDim.new(0, 4)}) })
		pressable(b, 0.96)
		b.MouseButton1Click:Connect(function() select(i, true) end)
		if hasGames and i >= 3 and i <= lastGame then b.Visible = false end -- games start collapsed
		b.Parent = tabsFrame
		tabButtons[i] = b
		local iconParts = buildIcon(b, iconKeyFor(name), i == 1 and Color3.new(1, 1, 1) or C.Secondary)
		tabIcon[i] = iconParts
		syncIconFade(b, iconParts)
	end
