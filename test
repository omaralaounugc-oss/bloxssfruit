				Size = UDim2.new(1, 0, 0, HEAD_H), BackgroundColor3 = BG_BAR, BorderSizePixel = 0, ZIndex = 6,
			}).Parent = field
			local nameLbl = new("TextLabel", {
				Size = UDim2.new(1, -310, 0, HEAD_H), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
				Text = "script.lua", Font = Enum.Font.Code, TextSize = 12, TextColor3 = C.Secondary,
				TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, TextTruncate = Enum.TextTruncate.AtEnd,
			})
			nameLbl.Parent = field

			-- status bar
			new("Frame", {
				Size = UDim2.new(1, 0, 0, STAT_H), Position = UDim2.new(0, 0, 1, -STAT_H), BackgroundColor3 = BG_BAR,
				BorderSizePixel = 0, ZIndex = 6,
