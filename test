local function notify(title, subtitle, state, tagText) -- state: true = green, false = red, nil = plain
	chime(state ~= false)
	pcall(function()
		if not main then return end
		if not toast or not toast.Parent then
			S.y, S.vy, S.s, S.vs, S.a, S.va = HIDDEN_Y, 0, 0.9, 0, 0, 0
			S.ta = 0
			buildToast()
		end
		toastTitle.Text = title
		toastSub.Text = subtitle or ""
		toastIcon.Image = LOGO_IMAGE or LOGO_ID
		toastTag.Visible = state ~= nil
		if state ~= nil then
			toastTag.BackgroundColor3 = state and C.Green or Color3.fromRGB(255, 69, 58)
			toastTagLabel.Text = tagText or (state and "ON" or "OFF")
			toastTagLabel.TextColor3 = state and C.Green or Color3.fromRGB(255, 69, 58)
		end

		toastToken += 1
		local mine = toastToken
		local hidden = not toast.Visible
		toast.Visible = true

		if hidden then
			S.y, S.vy, S.s, S.vs, S.a, S.va = HIDDEN_Y, 0, 0.9, 0, 0, 0
		end
		if hidden or S.ta == 0 then
			-- enter: springs in with a small, soft overshoot
			S.k, S.d = 230, 21
			S.ty, S.ts, S.ta = SHOWN_Y, 1, 1
		else
			-- already showing: gentle pulse
			S.s, S.vs = 0.955, 0
			S.k, S.d = 230, 21
			S.ts = 1
		end
		startLoop()

		task.delay(2.8, function()
			if mine ~= toastToken then return end
			-- exit: critically damped glide up while fading
			S.k, S.d = 200, 28
			S.ty, S.ts, S.ta = HIDDEN_Y + 10, 0.95, 0
			startLoop()
		end)
	end)
end

