--// Minimize: the hub shrinks into a small draggable bubble; tap the bubble to bring it back
local minimized = false
local setMin
do
	local bubble = new("ImageButton", {
		Name = "MinBubble", Size = UDim2.fromOffset(52, 52), Position = UDim2.new(0, 18, 0.5, -26),
		BackgroundColor3 = Color3.fromRGB(20, 20, 23), Image = "", ScaleType = Enum.ScaleType.Crop,
		AutoButtonColor = false, Visible = false, Active = false, ZIndex = 50,
	}, {
		new("UICorner", {CornerRadius = UDim.new(0.26, 0)}),
		new("UIStroke", {Color = Color3.new(1, 1, 1), Thickness = 1, Transparency = 0.8}),
	})
	local bScale = new("UIScale", {Scale = 1})
	bScale.Parent = bubble
	bubble.Parent = gui
	local brandF = sidebar:FindFirstChild("Brand")
	local logoImg = brandF and brandF:FindFirstChild("Logo")
	if logoImg then
		bubble.Image = logoImg.Image
		logoImg:GetPropertyChangedSignal("Image"):Connect(function() bubble.Image = logoImg.Image end)
	end

	setMin = function(on)
		if closing or on == minimized then return end
		minimized = on
		if on then
			fadeTree(holder, false, 0.22)
			tween(uiScale, 0.3, {Scale = 0.9})
			tween(blur, 0.45, {Size = 0}) -- clear the background blur while minimized
			task.delay(0.3, function()
				if minimized and not closing then holder.Visible = false end
			end)
			bubble.Visible = true
			bubble.Active = true   -- allow clicks only when bubble is shown
			bScale.Scale = 0.4
			tween(bScale, 0.45, {Scale = 1}, Enum.EasingStyle.Back)
		else
			holder.Visible = true
			hideTree(holder)
			fadeTree(holder, true, 0.4, 0)
			tween(blur, 0.6, {Size = 10})
			tween(uiScale, 0.5, {Scale = 1}, Enum.EasingStyle.Back)
			tween(bScale, 0.25, {Scale = 0.4})
			bubble.Active = false  -- stop bubble stealing clicks when hub is open
			task.delay(0.25, function()
				if not minimized then bubble.Visible = false end
			end)
		end
	end
	minBtn.MouseButton1Click:Connect(function() play("click"); buzz(0.2, 0.04); setMin(true) end)

	local dragging, moved, startIn, startPos
	bubble.InputBegan:Connect(function(input, gpe)
		if gpe then return end -- ignore if Roblox/game already handled this input
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging, moved, startIn, startPos = true, false, input.Position, bubble.Position
			tween(bScale, 0.12, {Scale = 0.9})
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					tween(bScale, 0.35, {Scale = 1}, Enum.EasingStyle.Back)
					if not moved then play("click"); buzz(0.2, 0.04); setMin(false) end
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - startIn
			if moved or d.Magnitude > 8 then
				moved = true
				bubble.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
					startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end
	end)
end

