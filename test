	--// Tabs + selection
	local current = 1
	local tabButtons = {}
	local tabIcon = {}
	local setIconColor -- defined below with the icon builder

	local function select(i, animate)
		if animate and i == current then return end
		if animate then play("tab") buzz(0.5, 0.04) end
		pages[current].frame.Visible = false
		current = i
		local page = pages[i].frame
		page.Visible = true
		pageTitle.Text = tabNames[i]
		local tabShown = i < 3 or i > lastGame or (gamesOpen and gameVis[i] ~= false)
		if tabShown then
			if not indShown then
				indicator.Position = tabPos(i)
				setIndicator(true, 0.3)
			else
				tween(indicator, animate and 0.45 or 0, {Position = tabPos(i)}, Enum.EasingStyle.Quint)
			end
		end
		if tabShown then
			local y = tabY(i)
			local view = tabsFrame.AbsoluteSize.Y / (math.max(uiScale.Scale, 0.01) * BASE)
			local cp, target = tabsFrame.CanvasPosition.Y, nil
			if y < cp then target = y elseif y + 36 > cp + view then target = y + 36 - view end
			if target then tween(tabsFrame, 0.4, {CanvasPosition = Vector2.new(0, math.max(target, 0))}) end
		end
		for j, b in ipairs(tabButtons) do
			setFont(b, j == i and F_BOLD or F_SEMI)
			tween(b, 0.25, {TextColor3 = j == i and Color3.new(1, 1, 1) or C.Secondary})
			if tabIcon[j] then setIconColor(tabIcon[j], j == i and Color3.new(1, 1, 1) or C.Secondary, 0.25) end
		end
		if animate then
			hideTree(page)
			page.Position = UDim2.fromOffset(0, 14)
			fadeTree(page, true, 0.35, 0)
			tween(page, 0.45, {Position = UDim2.fromOffset(0, 0)})
		end
	end

