	favBadge.Parent = tabButtons[2]
	local function updateBadge(n, animate)
		favBadge.Text = tostring(n)
		favBadge.Visible = n > 0
		if animate and n > 0 then
			badgeScale.Scale = 1.3
			tween(badgeScale, 0.5, {Scale = 1}, Enum.EasingStyle.Back)
		end
	end
	updateBadge(#favList())
	Fav.onChange(function() updateBadge(favPage.rebuild(), true) end)

	--// Profile chip
	local profile = new("Frame", {
		Name = "Profile", Size = UDim2.new(1, -40, 0, 48), Position = UDim2.new(0, 24, 1, -58),
		BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 3,
	}, { round(12) })
	profile.Parent = sidebar

	local lp = Players.LocalPlayer
	local isPremium = false
	pcall(function() isPremium = lp.MembershipType == Enum.MembershipType.Premium end)
	new("ImageLabel", {
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Color3.fromRGB(20, 20, 22), ZIndex = 4,
		Image = "rbxthumb://type=AvatarHeadShot&id=" .. lp.UserId .. "&w=150&h=150",
	}, {
		pill(),
		new("UIStroke", {Color = Color3.new(1, 1, 1), Thickness = 1, Transparency = 0.82}),
	}).Parent = profile

	local TextService = game:GetService("TextService")
	local function fitSize(text, font, maxSize, minSize, width)
		for sz = maxSize, minSize, -1 do
			local ok, b = pcall(function()
				return TextService:GetTextSize(text, sz, font, Vector2.new(4000, 40))
			end)
			if not ok or b.X <= width then return sz end
		end
		return minSize
	end
	local AVAIL = 104 -- room to the right of the avatar inside the sidebar
	local subText = isPremium and "Premium" or ("@" .. lp.Name)

	new("TextLabel", {
		Size = UDim2.fromOffset(400, 20), Position = UDim2.fromOffset(52, 6),
		BackgroundTransparency = 1, Text = lp.DisplayName, Font = F_BOLD,
		TextSize = fitSize(lp.DisplayName, F_BOLD, 14, 11, AVAIL),
		TextColor3 = C.Label, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.None, ZIndex = 4,
	}).Parent = profile
	local subLabel = new("TextLabel", {
		Size = UDim2.fromOffset(400, 16), Position = UDim2.fromOffset(52, 27),
		BackgroundTransparency = 1, Font = F_REG, TextSize = fitSize(subText, F_REG, 12, 10, AVAIL),
		Text = subText,
		TextColor3 = isPremium and Color3.fromRGB(255, 214, 10) or C.Secondary, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.None, ZIndex = 4,
	})
	subLabel.Parent = profile

	--// Time used: total hub time is saved to a file; tap your profile to flip between your @name and time used
	local STATS_FILE = "WOWHUB_Stats.json"
	local savedSeconds, startTick = 0, os.clock()
	pcall(function()
		if isfile and readfile and isfile(STATS_FILE) then
			savedSeconds = tonumber(HttpService:JSONDecode(readfile(STATS_FILE)).seconds) or 0
		end
	end)
	local function totalSeconds() return savedSeconds + (os.clock() - startTick) end
	local function saveStats()
		pcall(function()
			if writefile then writefile(STATS_FILE, HttpService:JSONEncode({seconds = math.floor(totalSeconds())})) end
		end)
	end
	local function fmtTime(sec)
		sec = math.floor(sec)
		local h, m = math.floor(sec / 3600), math.floor(sec % 3600 / 60)
		if h > 0 then return h .. "h " .. m .. "m used" end
		if m > 0 then return m .. "m used" end
		return "Just started"
	end
	local showTime = false
	local function refreshSub()
		local t = showTime and fmtTime(totalSeconds()) or subText
		subLabel.Text = t
		subLabel.TextSize = fitSize(t, F_REG, 12, 10, AVAIL)
	end
	local hit = new("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 6,
	})
	hit.Parent = profile
	hit.MouseButton1Click:Connect(function()
		showTime = not showTime
		play("click")
		buzz(0.4, 0.03)
		refreshSub()
	end)
	task.spawn(function()
		while profile.Parent do
			task.wait(30)
			saveStats()
			if showTime then refreshSub() end
		end
	end)
end

