			local function buildMatches()
				mLine, mCol = {}, {}
				curM, curLine, curCol = 0, nil, nil
				if qCmp ~= "" then
					local n = 0
					for i = 1, #lines do
						local ln = findCI and string.lower(lines[i]) or lines[i]
						local p = 1
						while n < MAXM do
							local s = string.find(ln, qCmp, p, true)
							if not s then break end
							n = n + 1
							mLine[n], mCol[n] = i, s
							p = s + #qCmp
						end
						if n >= MAXM then break end
					end
				end
				updateCount()
				refresh(true)
			end

			local function gotoMatch(k)
				if #mLine == 0 then return end
				if k > #mLine then k = 1 elseif k < 1 then k = #mLine end
				curM = k
