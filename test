local function doVerify(silent)
	if busy or closing then return end
	if locked then return end
	local k = normalizeKey(keyBox.Text)
	if k == "" then
		setStatus("Enter your key first", C.Red, C.Red, "No key")
		play("f1"); task.delay(0.1, function() play("f2") end); buzz(0.7, 0.08)
		task.spawn(shake)
		return
	end
	busy = true
	if not silent then play("click"); buzz(0.4, 0.04) end
	unlockBtn.Text = "Verifying"
	unlockBtn.TextColor3 = C.Ink
	unlockBtn.BackgroundColor3 = C.Accent
	setSpinner(true)
	setStatus("Checking your key...", C.Secondary, C.Gold, "Checking")
	local t0 = os.clock()
	local ok, info, msg = checkKey(k)
	local tries, maxTries = 0, CONFIG.Api.Retries or 1
	while not ok and info == "network" and CONFIG.Mode == "remote" and tries < maxTries and not closing do
		tries = tries + 1
		setStatus("Connection hiccup - retrying (" .. tries .. "/" .. maxTries .. ")...", C.Gold, C.Gold, "Retrying")
		task.wait(0.8 * tries)
		ok, info, msg = checkKey(k)
	end
	local rem = 0.6 - (os.clock() - t0)
	if rem > 0 then task.wait(rem) end
	setSpinner(false)
	if closing then return end
	if ok then
		if CONFIG.SaveKey then K.write(CONFIG.SaveFile, k) end
		K.fetchHub() -- no-op without HubUrl; otherwise the download runs while the success screen plays
		K.lockLevel = 0
		K.delete(CONFIG.LockFile)
		if CONFIG.ShareSession ~= false then
			pcall(function() getgenv().WOWHUB_Session = {Tier = info.tier, Expires = info.expires, Version = CONFIG.Version} end)
		end
		unlockBtn.Text = "Unlocked"
		tween(unlockBtn, 0.3, {BackgroundColor3 = C.Green})
		setStatus("Key accepted", C.Green, C.Green, "Unlocked")
		refreshSteps(true)
		play("n1"); task.delay(0.09, function() play("n2") end); task.delay(0.18, function() play("n3") end)
		buzz(0.8, 0.1)
		task.wait(0.25)
		showSuccess(info)
		task.wait(1.5)
		if CONFIG.HubUrl then -- if the hub is still downloading, say so instead of freezing on a full bar
			local th = os.clock()
			while K.hub.state == "loading" and os.clock() - th < 20 and not closing do
				if K.loadLbl and os.clock() - th > 0.15 then K.loadLbl.Text = "Downloading hub..." end
				task.wait(0.1)
			end
			if K.hub.state == "failed" and K.loadLbl then
				K.loadLbl.Text = "Download failed - retrying"
				K.loadLbl.TextColor3 = C.Gold
				task.wait(0.8)
			end
		end
		dismiss(function()
			local okr, err = pcall(ON_SUCCESS, info)
			if not okr then warn("[WOWHUB] script error: " .. tostring(err)) end
			K.runHub()
			if CONFIG.RunServerScript and info.script and info.script ~= "" then K.run(info.script, "server script") end
		end)
		return
	end
	-- failure
	unlockBtn.Text = "Unlock"
	local text = (msg and msg ~= "") and msg or ERR[info] or "Key rejected"
	local isNet = info == "network"
	setStatus(text, isNet and C.Gold or C.Red, isNet and C.Gold or C.Red, isNet and "Offline" or "Rejected")
	tween(fieldStroke, 0.15, {Color = isNet and C.Gold or C.Red, Transparency = 0.2})
	play("f1"); task.delay(0.1, function() play("f2") end); buzz(0.8, 0.08)
	if CONFIG.SaveKey and (info == "invalid" or info == "expired" or info == "blacklisted") then
		local saved = K.read(CONFIG.SaveFile)
		if saved and normalizeKey(saved) == k then K.delete(CONFIG.SaveFile) end
	end
	if KEY_FAULT[info] or info == "format" then fails = fails + 1 end
	shake()
	task.wait(0.5)
	tween(fieldStroke, 0.4, {Color = Color3.new(1, 1, 1), Transparency = 0.88})
	busy = false
	if fails >= CONFIG.MaxAttempts then
		fails = 0
		local secs = math.floor(math.min(CONFIG.LockSeconds * 2 ^ K.lockLevel, CONFIG.LockMax or 600))
		K.lockLevel = K.lockLevel + 1
		if CONFIG.PersistLock ~= false then K.write(CONFIG.LockFile, (os.time() + secs) .. "|" .. K.lockLevel) end
		K.startLock(secs)
	else
		refreshUnlock()
	end
end
