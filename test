		new("Frame", {
			Size = UDim2.fromOffset(2, 5), Position = UDim2.fromOffset(11, 11), AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = -45, BackgroundColor3 = C.Secondary, BorderSizePixel = 0, ZIndex = 6,
		}, { pill() }).Parent = sIcon

		local sBox = new("TextBox", {
			Size = UDim2.new(1, -58, 1, 0), Position = UDim2.fromOffset(33, 0), BackgroundTransparency = 1,
			Text = "", PlaceholderText = "Search games", PlaceholderColor3 = Color3.fromRGB(142, 142, 147),
			TextColor3 = C.Label, Font = F_REG, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false, ZIndex = 6,
		})
		sBox.Parent = sf

		local sClear = new("TextButton", {
			Size = UDim2.fromOffset(15, 15), Position = UDim2.new(1, -9, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
			BackgroundColor3 = Color3.fromRGB(142, 142, 147), Text = "", AutoButtonColor = false, Visible = false, ZIndex = 7,
		}, { pill() })
		for _, rot in ipairs({45, -45}) do
			new("Frame", {
				Size = UDim2.fromOffset(7, 1.5), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
				Rotation = rot, BackgroundColor3 = Color3.fromRGB(44, 44, 46), BorderSizePixel = 0, ZIndex = 8,
			}, { pill() }).Parent = sClear
		end
		sClear.Parent = sf

		sBox.Focused:Connect(function() tween(sfStroke, 0.3, {Color = C.Blue, Transparency = 0.35}) end)
		sBox.FocusLost:Connect(function() tween(sfStroke, 0.3, {Color = Color3.new(1, 1, 1), Transparency = 0.92}) end)

		local empty = new("TextLabel", {
			Name = "NoGames", Size = tabSize, BackgroundTransparency = 1, Text = "No games found", Font = F_REG,
			TextSize = 13, TextColor3 = C.Secondary, TextXAlignment = Enum.TextXAlignment.Left, Visible = false, ZIndex = 5,
		}, { new("UIPadding", {PaddingLeft = UDim.new(0, 14)}) })
		empty.Parent = tabsFrame

		-- re-position everything that depends on how many games are showing
		local function updateTail()
			tween(tabsFrame, 0.5, {CanvasSize = UDim2.fromOffset(0, tabY(#tabNames) + 40)})
			for t = lastGame + 1, #tabNames do tween(tabButtons[t], 0.5, {Position = tabPos(t)}) end
		end
		local function setEmpty(on)
			if on then
				if not empty.Visible then
					empty.Position = UDim2.fromOffset(10, tabY(3) + 6)
					empty.TextTransparency = 1
					empty.Visible = true
				end
				tween(empty, 0.35, {TextTransparency = 0})
			elseif empty.Visible then
				tween(empty, 0.2, {TextTransparency = 1})
				task.delay(0.22, function() if visibleGames() > 0 or not gamesOpen then empty.Visible = false end end)
			end
		end

		-- apply the current search text: matching games glide into place, the rest fade out
		local function applyFilter()
			local q = string.lower(sBox.Text or ""):match("^%s*(.-)%s*$")
			for idx = 3, lastGame do
				local ok = true
				for word in q:gmatch("%S+") do
					if not string.find(string.lower(tabNames[idx]), word, 1, true) then ok = false break end
				end
				gameVis[idx] = ok
			end
			sClear.Visible = sBox.Text ~= ""
			for k, b in ipairs(gameBtns) do
				local idx = 2 + k
				if gameVis[idx] ~= false then
					if not b.Visible then
						b.Position = tabPos(idx) + UDim2.fromOffset(0, 10)
						b.TextTransparency = 1
						b.Visible = true
					end
					tween(b, 0.4, {Position = tabPos(idx), TextTransparency = 0})
				elseif b.Visible then
					tween(b, 0.2, {TextTransparency = 1})
					task.delay(0.22, function() if gameVis[idx] == false then b.Visible = false end end)
				end
			end
			setEmpty(visibleGames() == 0)
			updateTail()
			if current >= 3 and current <= lastGame then
				if gameVis[current] ~= false then
					if indShown then
						tween(indicator, 0.4, {Position = tabPos(current)}, Enum.EasingStyle.Quint)
					else
						indicator.Position = tabPos(current)
						setIndicator(true, 0.3)
					end
				else
					setIndicator(false, 0.2)
				end
			end
		end
		sBox:GetPropertyChangedSignal("Text"):Connect(applyFilter)
		sClear.MouseButton1Click:Connect(function()
			sBox.Text = ""
			sBox:CaptureFocus()
		end)

		local anim = 0
		local function setGames(open)
			if open == gamesOpen then return end
			gamesOpen = open
			anim += 1
			local my = anim
			play("tab"); buzz(0.4, 0.04)
			tween(chev, 0.45, {Rotation = open and 0 or -90}, Enum.EasingStyle.Back)
			updateTail()
			local n = #gameBtns
			if open then
				-- search field drops in first, then the games follow one by one
				sf.Visible = true
				sf.Position = UDim2.new(0, 10, 0, SF_Y - 8)
				hideTree(sf)
				fadeTree(sf, true, 0.45, 0.03)
				tween(sf, 0.5, {Position = UDim2.new(0, 10, 0, SF_Y)})
				local order = 0
				for k, b in ipairs(gameBtns) do
					local idx = 2 + k
					if gameVis[idx] ~= false then
						order += 1
						local home = tabPos(idx)
						b.Visible = true
						b.TextTransparency = 1
						b.Position = UDim2.new(0, 0, 0, 84)
						task.delay(0.08 + (order - 1) * 0.06, function()
							if anim ~= my then return end
							tween(b, 0.55, {Position = home, TextTransparency = 0})
						end)
					end
				end
				setEmpty(visibleGames() == 0)
				if current >= 3 and current <= lastGame and gameVis[current] ~= false then
					indicator.Position = tabPos(current)
					task.delay(0.1 + (current - 3) * 0.06, function()
						if anim == my then setIndicator(true, 0.35) end
					end)
				end
			else
				sBox:ReleaseFocus()
				fadeTree(sf, false, 0.25)
				setEmpty(false)
				for k, b in ipairs(gameBtns) do
					task.delay((n - k) * 0.035, function()
						if anim ~= my then return end
						tween(b, 0.3, {Position = UDim2.new(0, 0, 0, 84), TextTransparency = 1})
					end)
				end
				if current >= 3 and current <= lastGame then setIndicator(false, 0.2) end
				task.delay(n * 0.035 + 0.35, function()
					if anim ~= my then return end
					for _, b in ipairs(gameBtns) do b.Visible = false end
					sf.Visible = false
					empty.Visible = false
				end)
			end
		end
		gh.MouseButton1Click:Connect(function() setGames(not gamesOpen) end)
		openGamesRef = setGames
	end

	--// Find My Game: detect the current game and jump to its map tab
	do
		local function norm(t) return (string.lower(tostring(t or "")):gsub("[^%w]", "")) end
		findMyGame = function()
			local wanted = PLACE_MAPS[game.PlaceId]
			local gameName = ""
			local pick, pickLen = nil, 0
			if wanted then
				local w = norm(wanted)
				for k, m in ipairs(MapOrder) do
					if norm(m) == w then pick = k break end
				end
			end
			if not pick then
				local ok, info = pcall(function()
					return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
				 end)
				gameName = (ok and info and info.Name) or ""
				local g = norm(gameName)
				if #g >= 4 then
					for k, m in ipairs(MapOrder) do
						local mn = norm(m)
						if #mn >= 4 and mn ~= "othergames" and #mn > pickLen
							and (string.find(g, mn, 1, true) or string.find(mn, g, 1, true)) then
							pick, pickLen = k, #mn
						end
					end
				end
			end
			if pick then
				if openGamesRef then openGamesRef(true) end
				select(2 + pick, true)
				notify("Game found", MapOrder[pick], true, "FOUND")
			else
				notify("Game not found", (gameName ~= "" and gameName or "Unknown game") .. " has no scripts yet", false, "NOT FOUND")
			end
		end
	end

	-- gold count badge on the Favorites tab
	local favBadge = new("TextLabel", {
