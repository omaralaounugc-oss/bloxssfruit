local function buzz(strength, dur)
	if not Options.Haptics then return end
	pcall(function()
		local input = Enum.UserInputType.Gamepad1
		if HapticService:IsVibrationSupported(input) then
			local motor = Enum.VibrationMotor.Small
			if HapticService:IsMotorSupported(input, motor) then
				HapticService:SetMotor(input, motor, strength)
				task.delay(dur, function() HapticService:SetMotor(input, motor, 0) end)
			end
		end
	end)
end

