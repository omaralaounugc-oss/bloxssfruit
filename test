	if ok and type(name) == "string" and name ~= "" then return string.sub(name, 1, 60) end
	return "Unknown"
end

local function cleanText(t, max) -- keeps typed text from breaking Discord markdown / mentions
	t = tostring(t or "")
	t = string.gsub(t, "[`*~|>@\\]", "")
	t = string.gsub(t, "__+", "_")
	t = string.gsub(t, "%c", " ")
	return string.sub(t, 1, max or 100)
end

local function sendSuggestionWebhook(gameName)
	if not webhookConfigured(DISCORD_SUGGEST_WEBHOOK_URL) then return "nourl" end
	local req = (syn and syn.request) or (http and http.request) or http_request or request
		or (fluxus and fluxus.request)
	if not req then return "norequest" end

	local lp = Players.LocalPlayer
	local userId = lp and lp.UserId or 0
	local username = lp and tostring(lp.Name) or "Unknown" -- Roblox names are only letters, numbers and _
	local display = lp and cleanText(lp.DisplayName, 40) or username
	local ageDays = lp and lp.AccountAge or 0
	local profile = "https://www.roblox.com/users/" .. tostring(userId) .. "/profile"

	local embed = {
		title = "New Game Suggestion",
		description = "**" .. cleanText(gameName, 100) .. "**",
		color = 0xA9CC62,
		author = {name = display .. " (@" .. username .. ")", url = profile},
		thumbnail = {url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. tostring(userId)
			.. "&width=150&height=150&format=png"},
		fields = {
			{name = "Roblox User", value = "`@" .. username .. "`\n[View profile](" .. profile .. ")", inline = true},
			{name = "User ID", value = "`" .. tostring(userId) .. "`", inline = true},
			{name = "Executor", value = "`" .. getExecutorName() .. "`", inline = true},
			{name = "Account Age", value = tostring(ageDays) .. " days", inline = true},
		},
		footer = {text = "WOWHUB v" .. HUB_VERSION .. "  |  Game Suggestions"},
		timestamp = DateTime.now():ToIsoDate(),
	}
	local ok, res = pcall(function()
		return req({
			Url = DISCORD_SUGGEST_WEBHOOK_URL,
			Method = "POST",
			Headers = {["Content-Type"] = "application/json"},
			Body = HttpService:JSONEncode({
				username = "WOWHUB Suggestions",
				allowed_mentions = {parse = {}}, -- typed text can never ping @everyone / roles
				embeds = {embed},
			}),
		})
	end)
	if not ok or type(res) ~= "table" then return "failed" end
	local code = tonumber(res.StatusCode or res.status_code or res.Status)
	if (code and code >= 200 and code < 300) or res.Success == true then return "sent" end
	return "failed"
end

