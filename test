-- ONE LINE = ONE SCRIPT. Copy a line, paste it, change the words.
--
--   Script("MAP NAME", "SCRIPT NAME", "IMAGE", "LINK", "DESCRIPTION")
--
--   MAP NAME     the game name. A NEW name creates a NEW MAP tab in the sidebar!
--   SCRIPT NAME  title on the card
--   IMAGE        script photo, like "rbxassetid://123456789"  ("" = blue placeholder)
--   LINK         the script link that runs when you press Execute
--   DESCRIPTION  small line under the title
--   CODE         (optional 6th part) raw code to run instead of a link, e.g. a script that needs a key:
--                Script("Map", "Name", "", "", "desc", [==[ script_key = "abc" loadstring(game:HttpGet("LINK"))() ]==])
--
--   Sidebar order = the order of the first line of each map.

local Scripts, MapOrder = {}, {}
local function Script(map, name, image, link, desc, code)
	if not Scripts[map] then
		Scripts[map] = {}
		table.insert(MapOrder, map)
	end
	table.insert(Scripts[map], {Name = name, Desc = desc or "", Image = image or "", Url = link or "", Code = code or ""})
end

