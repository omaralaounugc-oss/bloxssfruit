	local function buildIcon(parent, key, col)
		local draw = ICON_DRAW[key] or ICON_DRAW[TAB_ICON_DEFAULT]
		local box = new("Frame", {
			Name = "Icon", Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0, -26, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6,
		})
		box.Parent = parent
		local parts = {}
		local W = ICON_W
		local function add(f, kind, stroke)
			f.Parent = box
			table.insert(parts, {obj = f, kind = kind, stroke = stroke})
		end
		local d = {}
		function d.L(x1, y1, x2, y2, w)
			w = w or W
			local dx, dy = x2 - x1, y2 - y1
			add(new("Frame", {
				Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + w, w),
				Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2), AnchorPoint = Vector2.new(0.5, 0.5),
				Rotation = math.deg(math.atan2(dy, dx)), BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 6,
			}, { pill() }), "fill")
		end
		function d.P(pts, closed, w)
			for k = 1, #pts - 1 do d.L(pts[k][1], pts[k][2], pts[k + 1][1], pts[k + 1][2], w) end
			if closed and #pts > 2 then d.L(pts[#pts][1], pts[#pts][2], pts[1][1], pts[1][2], w) end
		end
		function d.O(cx, cy, r)
			local st = new("UIStroke", {Color = col, Thickness = W, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
			local rr = math.max(r - W / 2, 0.5)
			add(new("Frame", {
				Size = UDim2.fromOffset(rr * 2, rr * 2), Position = UDim2.fromOffset(cx, cy), AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6,
			}, { pill(), st }), "stroke", st)
		end
		function d.R(x, y, w, h, r)
			local st = new("UIStroke", {Color = col, Thickness = W, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
			add(new("Frame", {
				Size = UDim2.fromOffset(math.max(w - W, 1), math.max(h - W, 1)), Position = UDim2.fromOffset(x + w / 2, y + h / 2),
				AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6,
			}, { round(math.max(r - W / 2, 0)), st }), "stroke", st)
		end
		function d.D(cx, cy, r)
			add(new("Frame", {
				Size = UDim2.fromOffset(r * 2, r * 2), Position = UDim2.fromOffset(cx, cy), AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 6,
			}, { pill() }), "fill")
		end
		function d.E(cx, cy, rx, ry)
			add(new("Frame", {
				Size = UDim2.fromOffset(rx * 2, ry * 2), Position = UDim2.fromOffset(cx, cy), AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 6,
			}, { pill() }), "fill")
		end
		draw(d)
		return parts
	end
	local function iconKeyFor(name)
		local k = string.lower((string.gsub(name, "^%s*(.-)%s*$", "%1")))
		return TAB_ICON_KEY[k] or TAB_ICON_DEFAULT
	end
	setIconColor = function(parts, c, t)
		for _, pt in ipairs(parts) do
			if pt.kind == "fill" then tween(pt.obj, t, {BackgroundColor3 = c}) else tween(pt.stroke, t, {Color = c}) end
		end
	end
	local function syncIconFade(btn, parts) -- icon fades together with its tab text
		btn:GetPropertyChangedSignal("TextTransparency"):Connect(function()
			local tt = btn.TextTransparency
			for _, pt in ipairs(parts) do
				if pt.kind == "fill" then pt.obj.BackgroundTransparency = tt else pt.stroke.Transparency = tt end
			end
		end)
	end
