		local conns = {}
		local function cam() return workspace.CurrentCamera end

		-- Saved settings: kept in WOWHUB_Settings.json so they come back every time you run the hub
		local CFG_FILE = "WOWHUB_Settings.json"
		local Cfg = {}
		pcall(function()
			if isfile and readfile and isfile(CFG_FILE) then
				local t = HttpService:JSONDecode(readfile(CFG_FILE))
				if type(t) == "table" then Cfg = t end
			end
		end)
		local saveToken = 0
		local function saveCfg()
			saveToken += 1
			local my = saveToken
			task.delay(0.6, function() -- wait until the slider stops moving
				if my ~= saveToken then return end
				pcall(function() if writefile then writefile(CFG_FILE, HttpService:JSONEncode(Cfg)) end end)
			end)
		end

		-- Performance (updates twice a second while this tab is open)
		settingsPage.section("Performance")
		local fpsLbl  = settingsPage.info("FPS", "--")
		local pingLbl = settingsPage.info("Ping", "--")
		local memLbl  = settingsPage.info("Memory", "--")

		local function getPing()
			local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
			if ok and v then return math.floor(v + 0.5) end
			local ok2, p = pcall(function() return lp:GetNetworkPing() end)
			if ok2 and p then return math.floor(p * 1000 + 0.5) end
			return nil
		end
		local frames, acc = 0, 0
		table.insert(conns, RunService.RenderStepped:Connect(function(dt)
			frames += 1
			acc += dt
			if acc < 0.5 then return end
			local fps = math.floor(frames / acc + 0.5)
			frames, acc = 0, 0
			if not settingsPage.frame.Visible then return end
			fpsLbl.Text = tostring(fps)
			fpsLbl.TextColor3 = fps >= 50 and C.Green or (fps >= 30 and C.Gold or RED)
			local ping = getPing()
			if ping then
				pingLbl.Text = ping .. " ms"
				pingLbl.TextColor3 = ping < 100 and C.Green or (ping < 200 and C.Gold or RED)
			end
			local okm, mem = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
			if okm and mem then memLbl.Text = math.floor(mem + 0.5) .. " MB" end
		end))

		-- Camera
		settingsPage.section("Camera")
		local fovDefault = cam() and cam().FieldOfView or 70
		local fovOn, fovVal = false, fovDefault
		if type(Cfg.fov) == "number" then fovOn, fovVal = true, math.clamp(Cfg.fov, 30, 120) end
		local fovSlider = settingsPage.slider("Field of View", 30, 120, math.floor(fovVal + 0.5), function(v)
