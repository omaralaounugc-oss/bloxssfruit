				ScrollBarImageColor3 = C.Secondary, CanvasSize = UDim2.new(0, CANVAS_W, 0, ROW_H),
				ScrollingDirection = Enum.ScrollingDirection.XY, ClipsDescendants = true, ZIndex = 7,
				ElasticBehavior = Enum.ElasticBehavior.Always,
			})
			scroll.Parent = field
			do -- each swipe scrolls up/down OR left/right (whichever you move first), so the code never wobbles diagonally
				local swipe, startP
				scroll.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.Touch then
						swipe, startP = input, input.Position
						scroll.ScrollingDirection = Enum.ScrollingDirection.XY
					end
				end)
				game:GetService("UserInputService").InputChanged:Connect(function(input)
					if startP and input == swipe then
						local d = input.Position - startP
						if math.abs(d.X) > 8 or math.abs(d.Y) > 8 then
							scroll.ScrollingDirection = math.abs(d.Y) >= math.abs(d.X) and Enum.ScrollingDirection.Y or Enum.ScrollingDirection.X
							startP = nil
						end
					end
				end)
			end

			local function split(text)
				text = string.gsub(text, "\r\n", "\n")
				text = string.gsub(text, "\r", "\n")
				local out, n, pos = {}, 0, 1
				while true do
					local e = string.find(text, "\n", pos, true)
					n = n + 1
					if not e then out[n] = string.sub(text, pos) break end
					out[n] = string.sub(text, pos, e - 1)
					pos = e + 1
				end
				return out
			end
			local function fire() if changeFn then task.spawn(changeFn) end end

			-- ===== find state =====
			local findOpen, findCI = false, true
			local findQ, qCmp = "", ""
			local mLine, mCol = {}, {}
			local curM, curLine, curCol = 0, nil, nil

			local function lineMarks(ln, idx)
				if not findOpen or qCmp == "" then return nil end
				local low = findCI and string.lower(ln) or ln
				local p, n = 1, 0
				local ms, me, st = {}, {}, {}
				while n < 40 do
					local s = string.find(low, qCmp, p, true)
					if not s then break end
					n = n + 1
					ms[n], me[n] = s, s + #qCmp - 1
					st[n] = (idx == curLine and s == curCol)
					p = s + #qCmp
				end
				if n == 0 then return nil end
				return ms, me, st
			end

			local function paintRow(row, textOverride)
				local idx = row.idx
				local ln = textOverride or lines[idx]
				if #ln > LONG then
					row.hl.Text = esc(string.sub(ln, 1, 200)) .. '<font color="#6A9955">   ... [long line, ' .. #ln .. " chars, hidden]</font>"
					return
				end
				local ms, me, st = lineMarks(ln, idx)
				row.hl.Text = renderLine(ln, startState[idx] or 0, ms, me, st)
			end

			-- CanvasPosition / AbsoluteSize are in real screen pixels, but rows are placed in UI units.
			-- The hub is scaled (UIScale), so convert, otherwise rows drift off-screen while scrolling.
			local function K()
				local a = scroll.AbsoluteSize.Y
				if a > 1 and bodyH > 0 then return a / bodyH end
				return 1
			end
			local function getCP() local k = K() local p = scroll.CanvasPosition return Vector2.new(p.X / k, p.Y / k) end
			local function setCP(x, y) local k = K() scroll.CanvasPosition = Vector2.new(x * k, y * k) end

			local updateScrollUI = function() end -- defined below (scroll handle + arrows)
			local resizeTrack = function() end

			local function layoutNums()
				local cp = getCP()
				for _, row in ipairs(rows) do
					row.num.Position = UDim2.fromOffset(cp.X, (row.idx or 1) * ROW_H - ROW_H)
				end
			end

			local function refresh(force)
				local cp = getCP().Y
				local first = math.max(1, math.floor(cp / ROW_H) + 1)
				if first == lastFirst and not force then layoutNums() return end
				lastFirst = first
				refreshing = true
				local nVis = math.ceil(bodyH / ROW_H) + 3
				for i, row in ipairs(rows) do
					local idx = first + i - 1
					row.idx = idx
					if i <= nVis and idx <= #lines then
						local ln = lines[idx]
						local long = #ln > LONG
						row.editable = not long
						row.box.TextEditable = not long
						local shown = long and string.sub(ln, 1, 200) or ln
						if row.box.Text ~= shown then row.box.Text = shown end
						local y = (idx - 1) * ROW_H
						row.box.Position = UDim2.fromOffset(GUT_W + 8, y)
						row.hl.Position = UDim2.fromOffset(GUT_W + 8, y)
						row.bg.Position = UDim2.fromOffset(0, y)
						row.box.Visible, row.hl.Visible, row.bg.Visible, row.num.Visible = true, true, true, true
						row.num.Text = tostring(idx)
						row.num.TextColor3 = (idx == curLine) and C.Blue or C.Secondary
						local okPaint = pcall(paintRow, row)
						if not okPaint then row.hl.Text = "" end
					else
						row.idx = nil
						row.box.Visible, row.hl.Visible, row.bg.Visible, row.num.Visible = false, false, false, false
					end
				end
				refreshing = false
				layoutNums()
			end

			local function relayout()
				scroll.CanvasSize = UDim2.new(0, CANVAS_W + GUT_W, 0, (#lines + 1) * ROW_H)
				updateInfo()
				refresh(true)
				updateScrollUI()
			end

			local function scrollToLine(idx, col)
				local vh = scroll.AbsoluteSize.Y / K()
				if vh < ROW_H then vh = bodyH end
				local vw = scroll.AbsoluteSize.X / K()
				if vw < 100 then vw = 600 end
				local cp = getCP()
				local ty = math.max(0, (idx - 1) * ROW_H - vh / 2 + ROW_H / 2)
				local tx = cp.X
				if col then
					local px = (col - 1) * CHAR_W
					if px < cp.X or px > cp.X + vw - 220 then tx = math.max(0, px - vw / 3) end
				end
				lastFirst = -1
				setCP(tx, ty)
				refresh(true)
			end

			local function focusLine(idx)
				local vh = scroll.AbsoluteSize.Y / K()
				if vh < ROW_H then vh = bodyH end
				local cp = getCP()
				local top, bottom = (idx - 1) * ROW_H, idx * ROW_H
				if bottom > cp.Y + vh - 10 then setCP(cp.X, bottom - vh + 12)
				elseif top < cp.Y then setCP(cp.X, top) end
				refresh(true)
				for _, r in ipairs(rows) do
					if r.idx == idx and r.editable then r.box:CaptureFocus() break end
				end
			end

			-- put text into the editor: replaces it when empty, otherwise appends at the end
			local function ingest(text)
				local parts = split(text)
				if #lines == 1 and lines[1] == "" then
					lines = parts
					scroll.CanvasPosition = Vector2.new(0, 0)
				else
					table.move(parts, 1, #parts, #lines + 1, lines)
				end
				lastFirst = -1
				recomputeAll()
				relayout()
				fire()
				task.delay(0.15, function() scroll.CanvasPosition = Vector2.new(scroll.CanvasPosition.X, 0) lastFirst = -1 refresh(true) end)
				return #parts
			end

			-- ===== rows =====
			local function makeRow(i)
				local bg = new("Frame", {
					Size = UDim2.fromOffset(CANVAS_W + GUT_W, ROW_H), BackgroundColor3 = Color3.new(1, 1, 1),
					BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 8, Visible = false,
				})
				bg.Parent = scroll
				local hl = new("TextLabel", {
					Size = UDim2.fromOffset(CANVAS_W, ROW_H), BackgroundTransparency = 1, Text = "", RichText = true,
					Font = Enum.Font.Code, TextSize = TEXT_SIZE, TextColor3 = TXT, TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Center, TextWrapped = false, ZIndex = 9, Visible = false,
				})
				hl.Parent = scroll
				local box = new("TextBox", {
					Size = UDim2.fromOffset(CANVAS_W, ROW_H), BackgroundTransparency = 1, Text = "",
					Font = Enum.Font.Code, TextSize = TEXT_SIZE, TextColor3 = TXT,
					TextTransparency = LIVE_COLOR and 1 or 0,
					TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
					ClearTextOnFocus = false, MultiLine = false, TextWrapped = false, ZIndex = 10, Visible = false,
				})
				box.Parent = scroll
				local num = new("TextLabel", {
					Size = UDim2.fromOffset(GUT_W, ROW_H), BackgroundColor3 = BG_GUT, BackgroundTransparency = 0,
					BorderSizePixel = 0, Text = "", Font = Enum.Font.Code, TextSize = 12, TextColor3 = C.Secondary,
					TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 12, Visible = false,
				}, {
					new("UIPadding", {PaddingRight = UDim.new(0, 10)}),
				})
				num.Parent = scroll
				local row = {box = box, hl = hl, bg = bg, num = num, idx = nil, editable = true, emptiedAt = 0}
				rows[i] = row

				box:GetPropertyChangedSignal("Text"):Connect(function()
					if refreshing or not row.editable or not row.idx then return end
					local t = box.Text
					local idx = row.idx
					if string.find(t, "[\r\n]") then
						-- multi-line paste straight into a row: split it into real lines
						local parts = split(t)
						local new_ = table.move(lines, 1, idx - 1, 1, {})
						table.move(parts, 1, #parts, #new_ + 1, new_)
						table.move(lines, idx + 1, #lines, #new_ + 1, new_)
						lines = new_
						lastFirst = -1
						recomputeAll()
						relayout()
						fire()
						return
					end
					totalBytes = totalBytes - #lines[idx] + #t
					lines[idx] = t
					if t == "" then row.emptiedAt = os.clock() end
					if recomputeFrom(idx) then refresh(true) else paintRow(row, t) end
					updateInfo()
					fire()
					if row.onEdit then row.onEdit() end
				end)
				box:GetPropertyChangedSignal("CursorPosition"):Connect(function()
					if row.idx and box.CursorPosition > 0 then
						posLbl.Text = "Ln " .. row.idx .. ", Col " .. box.CursorPosition
					end
				end)
				box.Focused:Connect(function()
					bg.BackgroundTransparency = 0.94
					if row.idx and lines[row.idx] == "" then row.emptiedAt = 0 end
					if row.idx then posLbl.Text = "Ln " .. row.idx .. ", Col " .. math.max(1, box.CursorPosition) end
				end)
				box.FocusLost:Connect(function(enter)
					bg.BackgroundTransparency = 1
					if refreshing or not enter or not row.editable or not row.idx then return end
					local idx = row.idx
					local indent = string.match(lines[idx], "^[ \t]*") or ""
					table.insert(lines, idx + 1, indent)
					recomputeAll()
					relayout()
					fire()
					focusLine(idx + 1)
				end)
			end
			local function ensureRows()
				for i = #rows + 1, math.ceil(bodyH / ROW_H) + 3 do makeRow(i) end
			end
			ensureRows()

			scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function() refresh(false) end)

			-- ===== fast scroll handle + jump arrows =====
			-- Hold the handle on the right edge: it grows, a bubble shows the line number, and dragging
			-- moves through the WHOLE script smoothly (fast). The arrows glide to the first / last line.
			do
				local RunService = game:GetService("RunService")
				local TRACK_W = 36
				local dragging, dragInput, dragFrac, targetY = false, nil, 0, nil
				local thumbH, loopConn = 44, nil

				local function maxY() return math.max(0, (#lines + 1) * ROW_H - bodyH) end

				local track = new("TextButton", {
					Size = UDim2.fromOffset(TRACK_W, bodyH), Position = UDim2.new(1, -TRACK_W, 0, HEAD_H),
					BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false, Text = "", ZIndex = 20,
				})
				track.Parent = field
				resizeTrack = function() track.Size = UDim2.fromOffset(TRACK_W, bodyH) end
				local thumb = new("Frame", {
					Size = UDim2.fromOffset(5, thumbH), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 0),
					BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.65, BorderSizePixel = 0, ZIndex = 21,
				}, { round(6) })
				thumb.Parent = track

				local bubble = new("TextLabel", {
					Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -(TRACK_W + 8), 0, HEAD_H), BackgroundColor3 = Color3.fromRGB(16, 16, 18),
					BackgroundTransparency = 0.05, BorderSizePixel = 0, Text = "", Font = Enum.Font.Code, TextSize = 12,
					TextColor3 = Color3.new(1, 1, 1), Visible = false, ZIndex = 26,
				}, { round(13), new("UIPadding", {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12)}),
					new("UIStroke", {Color = C.Blue, Thickness = 1, Transparency = 0.4}) })
				bubble.Parent = field

				-- arrows (chevrons drawn from two rounded bars, no images)
				local function arrowBtn(up, yFromBottom)
					local b = new("TextButton", {
						Size = UDim2.fromOffset(34, 34), AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.new(1, -12, 1, -(STAT_H + yFromBottom)),
						BackgroundColor3 = Color3.fromRGB(46, 46, 52), BackgroundTransparency = 0.12, BorderSizePixel = 0,
						AutoButtonColor = false, Text = "", ZIndex = 22,
					}, { round(17), new("UIStroke", {Color = Color3.new(1, 1, 1), Thickness = 1, Transparency = 0.85,
						ApplyStrokeMode = Enum.ApplyStrokeMode.Border}) })
					local function bar(dx, rot)
						new("Frame", {
							Size = UDim2.fromOffset(12, 2.6), AnchorPoint = Vector2.new(0.5, 0.5),
							Position = UDim2.new(0.5, dx, 0.5, up and 1 or -1), Rotation = rot,
							BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 23,
						}, { round(2) }).Parent = b
					end
					if up then bar(-4.2, -45) bar(4.2, 45) else bar(-4.2, 45) bar(4.2, -45) end
					pressable(b, 0.88)
					b.Parent = field
					return b
				end
				local upBtn = arrowBtn(true, 84)
				local downBtn = arrowBtn(false, 44)

				-- smooth mover: eases CanvasPosition toward targetY (used by the handle and the arrows)
				local function stopLoop()
					if loopConn then loopConn:Disconnect() loopConn = nil end
				end
				local function ensureLoop()
					if loopConn then return end
					loopConn = RunService.RenderStepped:Connect(function(dt)
						if not targetY then stopLoop() return end
						local cp = getCP()
						local d = targetY - cp.Y
						if math.abs(d) < 1 then
							setCP(cp.X, targetY)
							if not dragging then targetY = nil stopLoop() end
							return
						end
						setCP(cp.X, cp.Y + d * (1 - math.exp(-dt * 20)))
					end)
				end
				local function glideTo(y) targetY = math.clamp(y, 0, maxY()) ensureLoop() end

				updateScrollUI = function()
					local mx = maxY()
					local total = (#lines + 1) * ROW_H
					track.Visible = mx > 0
					thumbH = math.clamp(bodyH * bodyH / total, 44, bodyH)
					local frac = dragging and dragFrac or (mx > 0 and math.clamp(getCP().Y / mx, 0, 1) or 0)
					thumb.Size = UDim2.fromOffset(dragging and 9 or 5, thumbH)
					thumb.Position = UDim2.new(1, -4, 0, frac * (bodyH - thumbH))
					if dragging then
						local ln = math.clamp(math.floor(frac * mx / ROW_H) + 1, 1, #lines)
						bubble.Text = "Line " .. ln .. " / " .. #lines
						bubble.Position = UDim2.new(1, -(TRACK_W + 8), 0, HEAD_H + frac * (bodyH - thumbH) + thumbH / 2)
					end
					local cy = getCP().Y
					upBtn.BackgroundTransparency = (mx > 0 and cy > ROW_H * 2) and 0.12 or 0.6
					downBtn.BackgroundTransparency = (mx > 0 and cy < mx - ROW_H * 2) and 0.12 or 0.6
				end
				scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(updateScrollUI)

				local function setDrag(on)
					dragging = on
					bubble.Visible = on
					tween(thumb, 0.15, {BackgroundTransparency = on and 0.05 or 0.65,
						BackgroundColor3 = on and C.Blue or Color3.new(1, 1, 1)})
					if on then buzz(0.5, 0.04) end
					pcall(function() page.ScrollingEnabled = not on end) -- the hub page must not scroll while dragging the handle
					updateScrollUI()
				end
				local function dragTo(screenY)
					local mx = maxY()
					local relY = (screenY - track.AbsolutePosition.Y) / K()
					dragFrac = math.clamp((relY - thumbH / 2) / math.max(bodyH - thumbH, 1), 0, 1)
					targetY = dragFrac * mx
					ensureLoop()
					updateScrollUI()
				end

				track.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragInput = input
						setDrag(true)
						dragTo(input.Position.Y)
					end
				end)
				UIS.InputChanged:Connect(function(input)
					if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
						dragTo(input.Position.Y)
					end
				end)
				UIS.InputEnded:Connect(function(input)
					if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1) then
						dragInput = nil
						setDrag(false)
					end
				end)
				-- touching the code itself cancels any glide so you can take over at any moment
				scroll.InputBegan:Connect(function(input)
					if not dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
						targetY = nil
						stopLoop()
					end
				end)

				upBtn.MouseButton1Click:Connect(function() play("click") buzz(0.5, 0.04) glideTo(0) end)
				downBtn.MouseButton1Click:Connect(function() play("click") buzz(0.5, 0.04) glideTo(maxY()) end)
				updateScrollUI()
			end

			-- ===== find / replace bar (Ctrl+F) =====
			local findBar = new("Frame", {
				Size = UDim2.fromOffset(344, 64), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, HEAD_H + 4),
				BackgroundColor3 = Color3.fromRGB(40, 40, 45), BorderSizePixel = 0, ZIndex = 30, Visible = false,
			}, { round(8), new("UIStroke", {Color = Color3.new(1, 1, 1), Transparency = 0.85, Thickness = 1}) })
			findBar.Parent = field

			local function miniBox(x, y, w, placeholder)
				local f = new("Frame", {
					Size = UDim2.fromOffset(w, 24), Position = UDim2.fromOffset(x, y), BackgroundColor3 = BG_CODE,
					BorderSizePixel = 0, ZIndex = 31,
				}, { round(6) })
				f.Parent = findBar
				local b = new("TextBox", {
					Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0), BackgroundTransparency = 1, Text = "",
					PlaceholderText = placeholder, PlaceholderColor3 = Color3.fromRGB(120, 120, 126), TextColor3 = TXT,
					Font = Enum.Font.Code, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
					ClearTextOnFocus = false, ZIndex = 32,
				})
				b.Parent = f
				return b
			end
			local function miniBtn(text, x, y, w, cb)
				local b = new("TextButton", {
					Size = UDim2.fromOffset(w, 24), Position = UDim2.fromOffset(x, y), BackgroundColor3 = BG_CODE,
					BorderSizePixel = 0, AutoButtonColor = false, Text = text, Font = F_SEMI, TextSize = 12,
					TextColor3 = TXT, ZIndex = 31,
				}, { round(6) })
				b.Parent = findBar
				b.MouseButton1Click:Connect(function() play("click") cb(b) end)
				return b
