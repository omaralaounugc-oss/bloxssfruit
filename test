local F_XBOLD, F_BOLD, F_SEMI, F_REG = Enum.Font.GothamBlack, Enum.Font.GothamBold, Enum.Font.GothamMedium, Enum.Font.Gotham
local function interFace(weight)
	local ok, f = pcall(function() return Font.new("rbxasset://fonts/families/Inter.json", weight, Enum.FontStyle.Normal) end)
	return ok and f or nil
end
local FACES = {
	[F_XBOLD] = interFace(Enum.FontWeight.Bold),
	[F_BOLD]  = interFace(Enum.FontWeight.SemiBold),
	[F_SEMI]  = interFace(Enum.FontWeight.Medium),
	[F_REG]   = interFace(Enum.FontWeight.Regular),
}
local function setFont(inst, f)
	local face = FACES[f]
	if face and pcall(function() inst.FontFace = face end) then return end
	inst.Font = f
end

local function new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k == "Font" then setFont(inst, v) else inst[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	return inst
end
