--// drag (clamped on screen) + keyboard avoidance
do
	local dragging, dragStart, startOff
	for _, target in ipairs(dragTargets) do
		on(target.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging, dragStart, startOff = true, input.Position, dragOff
				local c; c = input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then dragging = false; c:Disconnect() end
				end)
			end
		end)
	end
	on(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = (input.Position - dragStart) / BASE
			local v = viewport() or Vector2.new(800, 400)
			local mx, my = v.X / (2 * BASE) - 80, v.Y / (2 * BASE) - 60
			dragOff = Vector2.new(math.clamp(startOff.X + d.X, -mx, mx), math.clamp(startOff.Y + d.Y, -my, my))
			applyPos(0.06)
		end
	end)
	pcall(function()
		on(UserInputService:GetPropertyChangedSignal("OnScreenKeyboardVisible"), function()
			local v = viewport()
			if not v then return end
			kbY = 0
			if UserInputService.OnScreenKeyboardVisible then
				local kbTop = UserInputService.OnScreenKeyboardPosition.Y
				local top = v.Y / 2 + ((TOP_R - BOT_R) / 2 - (GRAB / 2) * BASE) + dragOff.Y * BASE - H * BASE / 2
				local need = top + (UNLOCK_Y + UNLOCK_H) * BASE + 8 - kbTop
				local limit = math.max(top - TOP_R, 0)
				kbY = -math.clamp(need, 0, limit) / BASE
			end
			applyPos(0.25)
		end)
	end)
end

