function K.tint(share, base) return (base or Color3.fromRGB(14, 14, 16)):Lerp(K.accent, share) end
function K.dbg(...) if CONFIG.Debug then print("[WOWHUB]", ...) end end
function K.clip(s, n)
	s = tostring(s == nil and "" or s):gsub("%c", " ")
	if #s > n then s = s:sub(1, n - 1) .. "..." end
	return s
end
function K.read(path)
	local ok, v = pcall(function() if isfile and readfile and isfile(path) then return readfile(path) end end)
	return ok and v or nil
end
function K.write(path, data) return (pcall(function() writefile(path, data) end)) end
function K.delete(path) pcall(function() if isfile and delfile and isfile(path) then delfile(path) end end) end
function K.httpReq() return request or http_request or (syn and syn.request) or (fluxus and fluxus.request) end
function K.run(code, label) -- compile + run a Lua source string, with readable errors
	if type(code) ~= "string" or code == "" then return false end
	if type(loadstring) ~= "function" then warn("[WOWHUB] " .. label .. ": loadstring is not available") return false end
	local fn, err = loadstring(code)
	if not fn then warn("[WOWHUB] " .. label .. " compile error: " .. tostring(err)) return false end
	local ok, e = pcall(fn)
	if not ok then warn("[WOWHUB] " .. label .. " runtime error: " .. tostring(e)) end
	return ok
end
function K.fetchHub() -- safe to call twice; used by Prefetch and again on unlock
	local H = K.hub
	if not CONFIG.HubUrl or H.state == "loading" or H.state == "done" then return end
	H.state = "loading"
	task.spawn(function()
		local ok, body = pcall(function() return game:HttpGet(CONFIG.HubUrl) end)
		if not (ok and type(body) == "string" and body ~= "") then
			local req = K.httpReq()
			if req then
				local ok2, r = pcall(req, {Url = CONFIG.HubUrl, Method = "GET"})
				if ok2 and r and (r.StatusCode == nil or r.StatusCode == 200) and type(r.Body) == "string" and r.Body ~= "" then
					ok, body = true, r.Body
				end
			end
		end
		if ok and type(body) == "string" and body ~= "" then H.src, H.state = body, "done"
		else H.state = "failed"; K.dbg("hub download failed") end
	end)
end
function K.runHub()
	if not CONFIG.HubUrl then return end
	K.fetchHub()
	local t0 = os.clock()
	while K.hub.state == "loading" and os.clock() - t0 < 30 do task.wait(0.05) end
	if K.hub.state ~= "done" then warn("[WOWHUB] couldn't download the hub from HubUrl") return end
	K.run(K.hub.src, "hub")
end

