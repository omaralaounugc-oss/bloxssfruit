				local q = string.lower(box.Text or ""):match("^%s*(.-)%s*$")
				local n = 0
				for _, c in ipairs(cards) do
					local vis = true
					if vis and q ~= "" then
						for word in q:gmatch("%S+") do
							if not string.find(c.hay, word, 1, true) then vis = false break end
						end
					end
					c.frame.Visible = vis
					if vis then n += 1 end
				end
				count.Text = n .. (n == 1 and " SCRIPT" or " SCRIPTS")
				empty.Visible = n == 0
				clear.Visible = box.Text ~= ""
				page.CanvasPosition = Vector2.new(0, 0)
				if animate then
					local k = 0
					for _, c in ipairs(cards) do
						if c.frame.Visible then
							k += 1
							hideTree(c.frame)
							fadeTree(c.frame, true, 0.45, 0.06 * (k - 1))
						end
					end
				end
			end
			box:GetPropertyChangedSignal("Text"):Connect(api.refresh)

			api.refresh()
		end

		return api
