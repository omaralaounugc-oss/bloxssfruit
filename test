	local suggestPage = makePage()
	do
		local RED = Color3.fromRGB(255, 69, 58)
		suggestPage.label("Suggest a game")
		suggestPage.note("Type the name of a game you want WOWHUB to support. Your suggestion, Roblox username and executor are sent to the WOWHUB team on Discord.")
		local gameBox, gameErr = suggestPage.input("Game name", "e.g. Blox Fruits", 44, false)
		local msg = suggestPage.note("")
		msg.Visible = false

		local function showError(text)
			gameErr(true)
			msg.Text = "\u{26A0}  " .. text
			msg.TextColor3 = RED
			msg.Visible = true
			play("click")
			notify("Game Suggestion", text, false, "ERROR")
		end
		gameBox:GetPropertyChangedSignal("Text"):Connect(function()
			if msg.Visible then gameErr(false) msg.Visible = false end
		end)

		local busy, lastSent = false, 0
		local sendBtn
		sendBtn = suggestPage.action("Send suggestion", function()
			if busy then return end
			local name = string.gsub(gameBox.Text, "%c", " ")
			name = string.gsub(name, "^%s+", "")
			name = string.gsub(name, "%s+$", "")
			if name == "" then showError("Type a game name first.") return end
			if #name > 60 then showError("Keep it under 60 characters.") return end
			local waitLeft = 30 - (os.clock() - lastSent)
			if lastSent > 0 and waitLeft > 0 then
				showError("Please wait " .. math.ceil(waitLeft) .. "s before sending another one.")
				return
			end
			busy = true
			sendBtn.Text = "Sending..."
			local result = sendSuggestionWebhook(name)
			if result == "sent" then
				lastSent = os.clock()
				gameBox.Text = ""
				notify("Game Suggestion", "Sent, thank you!", true, "SENT")
				sendBtn.Text = "Sent"
			elseif result == "nourl" then
				notify("Game Suggestion", "Webhook URL not set", nil, "WARN")
			elseif result == "norequest" then
				notify("Game Suggestion", "Your executor can't send webhooks", nil, "WARN")
			else
				notify("Game Suggestion", "Could not send, try again", false, "WARN")
