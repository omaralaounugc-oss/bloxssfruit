	-- preload the logo, textures, sounds and script thumbnails; the bar follows real progress
	function Splash.run()
		if not root then return end
		local startT = os.clock()
		local logoDone, allDone, done = false, false, 0

		task.spawn(function()
			local ok, res = pcall(function()
				local o = game:GetObjects(LOGO_ID)[1]
				if o and (o:IsA("Decal") or o:IsA("Texture")) then return o.Texture end
				if o and (o:IsA("ImageLabel") or o:IsA("ImageButton")) then return o.Image end
			end)
			LOGO_IMAGE = (ok and res and res ~= "") and res or LOGO_ID
			if img and img.Parent then img.Image = LOGO_IMAGE end
			logoDone = true
		end)

		local assets = {LOGO_ID, TEXTURE_ID, CLICK}
		for _, list in pairs(Scripts) do
			for _, sc in ipairs(list) do
				if sc.Image and sc.Image ~= "" then table.insert(assets, sc.Image) end
			end
		end
		task.spawn(function()
			pcall(function() ContentProvider:PreloadAsync(assets, function() done += 1 end) end)
			allDone = true
		end)

		local shown = 0
		while root.Parent do
			local el = os.clock() - startT
			local real = (logoDone and 0.25 or 0) + 0.65 * (allDone and 1 or math.min(done / #assets, 1))
			local target = math.min(real, math.min(el / MIN_TIME, 1) * 0.92) -- the bar never outruns the minimum time
			if target > shown then shown = math.min(target, shown + math.max((target - shown) * 0.18, 0.002)) end
			fill.Size = UDim2.fromScale(shown, 1)
			setStatus(shown < 0.35 and "Loading interface" or (shown < 0.75 and "Preparing scripts" or "Almost ready"))
			if (logoDone and allDone and el >= MIN_TIME) or el >= MAX_TIME then break end
			task.wait()
		end
	end

	-- bar fills, "Ready", then the splash dissolves while the hub rises
	function Splash.finish()
		if not root or not root.Parent then return end
		tween(fill, 0.3, {Size = UDim2.fromScale(1, 1)})
		setStatus("Ready")
		play("on")
		if shimmer then shimmer:Cancel() end
		-- Continue lights up (white capsule) and the hub waits for the tap
		ready = true
		tween(continueBtn, 0.4, {BackgroundColor3 = Color3.new(1, 1, 1), TextColor3 = Color3.fromRGB(10, 10, 12)})
		while not continued and root.Parent do task.wait() end
		task.wait(0.05)
		if not root.Parent then return end
		if pulse then pulse:Cancel() end
		if shimmer then shimmer:Cancel() end
		fadeOut(root, 0.6)
		tween(centerScale, 0.6, {Scale = centerScale.Scale * 1.07})
		local r = root
		task.delay(0.75, function() r:Destroy() end)
	end

	function Splash.abort()
		if not root then return end
		if pulse then pulse:Cancel() end
		if shimmer then shimmer:Cancel() end
		tween(blur, 0.3, {Size = 0})
		root:Destroy()
	end
end

