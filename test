		local sIcon = new("Frame", {
			Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 11, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
			BackgroundTransparency = 1, ZIndex = 6,
		})
		sIcon.Parent = sf
