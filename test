--// Discord webhook: sends the Own Script submission as an embed
-- returns: "sent" | "nourl" (placeholder not replaced) | "norequest" (executor has no http request) | "failed"
local function webhookConfigured(u)
	u = u or DISCORD_WEBHOOK_URL
	return type(u) == "string" and string.find(u, "discord", 1, true) ~= nil
		and string.find(u, "/api/webhooks/", 1, true) ~= nil
end

local function sendEmbedOnly(title, kind, content) -- kind: "Source" or "Script"
	if not webhookConfigured() then return "nourl" end
	local req = (syn and syn.request) or (http and http.request) or http_request or request
		or (fluxus and fluxus.request)
	if not req then return "norequest" end

	local isSource = kind == "Source"
	local MAX = 3800 -- keeps the embed under Discord's 4096-character description limit
	local body = content
	local cut = #body > MAX
	if cut then body = string.sub(body, 1, MAX) end
	body = string.gsub(body, "```", "`\226\128\139``") -- stop the content from closing the code block early

	local embed = {
		title = "New Own Script submission",
		color = 0xA9CC62,
		fields = {
			{name = "Title", value = string.sub(title, 1, 256), inline = true},
			{name = "Type", value = isSource and "Source (link)" or "Raw Code (Script)", inline = true},
		},
		description = (isSource and "**Source**" or "**Script**") .. "\n```" .. (isSource and "" or "lua") .. "\n"
			.. body .. "\n```" .. (cut and "\n*...content was cut to fit Discord's limit*" or ""),
		footer = {text = "WOWHUB v" .. HUB_VERSION},
		timestamp = DateTime.now():ToIsoDate(),
	}
	local ok, res = pcall(function()
		return req({
			Url = DISCORD_WEBHOOK_URL,
			Method = "POST",
			Headers = {["Content-Type"] = "application/json"},
			Body = HttpService:JSONEncode({
				username = "WOWHUB",
				allowed_mentions = {parse = {}}, -- user text can never ping @everyone / roles
				embeds = {embed},
			}),
		})
	end)
	if not ok or type(res) ~= "table" then return "failed" end
	local code = tonumber(res.StatusCode or res.status_code or res.Status)
	if (code and code >= 200 and code < 300) or res.Success == true then return "sent" end
	return "failed"
end

-- Sends the whole script as a .lua FILE attachment (multipart upload), so nothing gets cut. Big scripts are split into
-- several files at line breaks (each part stays under Discord's upload limit). Falls back to the old text embed if the
-- file upload is refused.
local FILE_PART_MAX = 8 * 1024 * 1024 -- bytes per message (Discord's default upload limit is about 10 MB)
local function sendOwnScriptWebhook(title, kind, content) -- kind: "Source" or "Script"
	if not webhookConfigured() then return "nourl" end
	local req = (syn and syn.request) or (http and http.request) or http_request or request
		or (fluxus and fluxus.request)
	if not req then return "norequest" end

	-- cut the script into parts at line breaks
	local parts = {}
	local pos, len = 1, #content
	while pos <= len do
		local stop = math.min(pos + FILE_PART_MAX - 1, len)
		if stop < len then
			local cutAt, i = nil, stop
			while i > pos do
				if string.byte(content, i) == 10 then cutAt = i break end
				i = i - 1
			end
			if cutAt then stop = cutAt end
		end
		table.insert(parts, string.sub(content, pos, stop))
		pos = stop + 1
	end
	if #parts == 0 then parts[1] = "" end

	local safe = string.gsub(tostring(title), "[^%w%-_ ]", "")
	safe = string.gsub(string.sub(safe, 1, 40), "%s+", "_")
	if safe == "" then safe = "script" end
	local lineCount = select(2, string.gsub(content, "\n", "")) + 1
	local allOk = true

	for i, part in ipairs(parts) do
		local fname = (#parts == 1) and (safe .. ".lua") or (safe .. "_part" .. i .. "of" .. #parts .. ".lua")
		local preview = string.gsub(string.sub(part, 1, 700), "```", "`\226\128\139``")
		local embed = {
			title = (#parts == 1) and "New Own Script submission" or ("New Own Script submission (part " .. i .. "/" .. #parts .. ")"),
			color = 0xA9CC62,
			fields = {
				{name = "Title", value = string.sub(tostring(title), 1, 256), inline = true},
				{name = "Type", value = "Raw Code (Script)", inline = true},
				{name = "Size", value = tostring(lineCount) .. " lines, " .. string.format("%.1f", #content / 1024) .. " KB", inline = true},
			},
			description = "Full script attached as **" .. fname .. "**\n```lua\n" .. preview .. "\n```",
			footer = {text = "WOWHUB v" .. HUB_VERSION},
			timestamp = DateTime.now():ToIsoDate(),
		}
		local json = HttpService:JSONEncode({
			username = "WOWHUB",
			allowed_mentions = {parse = {}}, -- user text can never ping @everyone / roles
			embeds = {embed},
		})
		local boundary = "----WOWHUB" .. string.gsub(HttpService:GenerateGUID(false), "-", "")
		local body = "--" .. boundary .. "\r\n"
			.. 'Content-Disposition: form-data; name="payload_json"\r\n'
			.. "Content-Type: application/json\r\n\r\n"
			.. json .. "\r\n"
			.. "--" .. boundary .. "\r\n"
			.. 'Content-Disposition: form-data; name="files[0]"; filename="' .. fname .. '"\r\n'
			.. "Content-Type: text/plain\r\n\r\n"
			.. part .. "\r\n"
			.. "--" .. boundary .. "--\r\n"

		local ok, res = pcall(function()
			return req({
				Url = DISCORD_WEBHOOK_URL,
				Method = "POST",
				Headers = {["Content-Type"] = "multipart/form-data; boundary=" .. boundary},
				Body = body,
			})
		end)
		local good = false
		if ok and type(res) == "table" then
			local code = tonumber(res.StatusCode or res.status_code or res.Status)
			good = (code and code >= 200 and code < 300) or res.Success == true
		end
		if not good then allOk = false break end
		if i < #parts then task.wait(1.2) end -- stay under Discord's webhook rate limit
	end

	if allOk then return "sent" end
	return sendEmbedOnly(title, kind, content) -- file upload refused: fall back to the cut-off text embed
end

